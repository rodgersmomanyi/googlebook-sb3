.encoding = "windows-1252"
# Googlebook lapis VM for VMware Workstation 17.5+ (virtual hardware 21): TEMPLATE from googlebook-sb3.
# Copy to <workspace>\lapis-boot.vmx, next to lapis.bin and lapis.vmdk (vm\make_vmdk.py). VMware generates the
# UUIDs, the MAC address and its own runtime keys on first power-on. See docs/VMWARE.md for every setting.
# Keep nvme0.pciSlotNumber = 2208: the guest then sees the disk behind root port 0000:00:15.2, which is what
# build_esp.py passes as androidboot.boot_devices for the VM.
# cpuid masks: hide AVX-VNNI (leaf 7.1 EAX bit 4) and GFNI (leaf 7 ECX bit 8) from the guest.
# serial0 = kernel/Android console log (serial0.log); serial1 = named pipe \\.\pipe\lapis_con for gbsh.py.
displayName = "Googlebook lapis"
config.version = "8"
virtualHW.version = "21"
guestOS = "other6xlinux-64"
firmware = "efi"
uefi.secureBoot.enabled = "FALSE"
memSize = "12288"
numvcpus = "4"
cpuid.coresPerSocket = "4"
vhv.enable = "TRUE"
cpuid.7.1.eax = "---------------------------0----"
cpuid.7.ecx = "-----------------------0--------"
nvme0.present = "TRUE"
nvme0:0.present = "TRUE"
nvme0:0.fileName = "lapis.vmdk"
nvme0:0.deviceType = "disk"
nvme0:0.mode = "independent-persistent"
serial0.present = "TRUE"
serial0.fileType = "file"
serial0.fileName = "serial0.log"
serial0.yieldOnMsrRead = "TRUE"
svga.present = "TRUE"
svga.graphicsMemoryKB = "2097152"
usb_xhci.present = "TRUE"
mouse.vusb.enable = "FALSE"
mouse.vusb.useBasicMouse = "FALSE"
ethernet0.present = "TRUE"
ethernet0.connectionType = "nat"
ethernet0.virtualDev = "vmxnet3"
ethernet0.addressType = "generated"
tools.syncTime = "FALSE"
nvram = "lapis-boot.nvram"
msg.autoAnswer = "TRUE"
pciBridge0.present = "TRUE"
pciBridge4.present = "TRUE"
pciBridge4.virtualDev = "pcieRootPort"
pciBridge4.functions = "8"
virtualHW.productCompatibility = "hosted"
svga.vramSize = "268435456"
pciBridge0.pciSlotNumber = "17"
pciBridge4.pciSlotNumber = "21"
ethernet0.pciSlotNumber = "160"
usb_xhci.pciSlotNumber = "1184"
nvme0.pciSlotNumber = "2208"
mks.enable3d = "TRUE"
svga.guestBackedPrimaryAware = "TRUE"
serial1.present = "TRUE"
serial1.fileType = "pipe"
serial1.fileName = "\\.\pipe\lapis_con"
serial1.pipe.endPoint = "server"
serial1.tryNoRxLoss = "TRUE"
serial1.yieldOnMsrRead = "TRUE"
serial1.startConnected = "TRUE"
priority.grabbed = "high"
mks.svgaThread.forcePolling = "FALSE"
mks.svgaThread.pollUS = "250"
chipset.useAcpiBattery = "TRUE"
chipset.useApmBattery = "TRUE"
sound.present = "TRUE"
sound.virtualDev = "hdaudio"
sound.fileName = "-1"
sound.autodetect = "TRUE"
sound.pciSlotNumber = "32"
sound.minProgressUsec = "2000"
sound.maxPeriodSizeMS = "10"
sound.bufferIdealMS = "60"
