Subject: [PATCH] svga, egl/android: Googlebook VM fixes (RGBA windows, BGRA import, shader cache)

Applied by hand on top of mesa-26.3.0-rc2 (b34c71d9ff2f6514a1f947609d00e49be639edf8) before graphics/mesa/build_mesa.sh's configure step:
 GB_RGBA_WINDOW   svga: R8G8B8A8_UNORM accepted as a display/window format and R8G8B8X8 mapped (Android windows are
                  RGBA_8888; with the GB_RGBA_DUMB vmwgfx every 32bpp gralloc buffer is an R8G8B8A8 surface).
 GB_BGRA_AS_RGBA  egl/android: if a BGRA (ARGB8888/XRGB8888) dma-buf import fails, retry as its R/B-swapped RGBA
                  twin (CPU-written BGRA pixels then show R/B swapped; GPU-produced content stays consistent).
 GB_SHADER_CACHE  svga: disk shader cache hook, so EGL_ANDROID_blob_cache is exposed and linked programs persist in
                  the per-app blob cache (same change as graphics/mesa/patch_svga_shader_cache.py, ported to
                  BLAKE3 for 26.3).
Apply in mesa/ with: git apply <this file>. License: MIT (Mesa).
---
diff --git a/src/egl/drivers/dri2/platform_android.c b/src/egl/drivers/dri2/platform_android.c
index 5da2a2523b0..7c82135bd39 100644
--- a/src/egl/drivers/dri2/platform_android.c
+++ b/src/egl/drivers/dri2/platform_android.c
@@ -58,13 +58,31 @@ droid_create_image_from_buffer_info(
    struct u_gralloc_buffer_color_info *color_info, void *priv)
 {
    unsigned error;
+   uint32_t fourcc = buf_info->drm_fourcc;
+   struct dri_image *img;
 
-   return dri2_from_dma_bufs(
-      dri2_dpy->dri_screen_render_gpu, width, height, buf_info->drm_fourcc,
+   img = dri2_from_dma_bufs(
+      dri2_dpy->dri_screen_render_gpu, width, height, fourcc,
       buf_info->modifier, buf_info->fds, buf_info->num_planes,
       buf_info->strides, buf_info->offsets, color_info->yuv_color_space,
       color_info->sample_range, color_info->horizontal_siting,
       color_info->vertical_siting, 0, &error, priv);
+
+   /* GB_BGRA_AS_RGBA: on VMware with the GB_RGBA_DUMB vmwgfx every 32bpp gralloc buffer is an R8G8B8A8
+    * surface, so svga refuses a BGRA import. Import it as its R/B-swapped RGBA twin instead: GPU-produced
+    * content stays consistent (producer and consumer both import through here); only CPU-written BGRA
+    * pixels show R/B swapped. */
+   if (!img && (fourcc == DRM_FORMAT_ARGB8888 || fourcc == DRM_FORMAT_XRGB8888)) {
+      fourcc = fourcc == DRM_FORMAT_ARGB8888 ? DRM_FORMAT_ABGR8888 : DRM_FORMAT_XBGR8888;
+      img = dri2_from_dma_bufs(
+         dri2_dpy->dri_screen_render_gpu, width, height, fourcc,
+         buf_info->modifier, buf_info->fds, buf_info->num_planes,
+         buf_info->strides, buf_info->offsets, color_info->yuv_color_space,
+         color_info->sample_range, color_info->horizontal_siting,
+         color_info->vertical_siting, 0, &error, priv);
+   }
+
+   return img;
 }
 
 static struct dri_image *
