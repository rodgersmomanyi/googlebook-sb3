    [ PIPE_FORMAT_R8_USCALED ] =            { SVGA3D_R8_UINT,             SVGA3D_FORMAT_INVALID,       SVGA3D_FORMAT_INVALID,       VF_U_TO_F_CAST },
    [ PIPE_FORMAT_R8G8_USCALED ] =          { SVGA3D_R8G8_UINT,           SVGA3D_FORMAT_INVALID,       SVGA3D_FORMAT_INVALID,       VF_U_TO_F_CAST },
    [ PIPE_FORMAT_R8G8B8_USCALED ] =        { SVGA3D_R8G8B8A8_UINT,       SVGA3D_FORMAT_INVALID,       SVGA3D_FORMAT_INVALID,       VF_W_TO_1 | VF_U_TO_F_CAST },
@@ -2223,6 +2224,7 @@ svga_is_format_supported(struct pipe_screen *screen,
       case SVGA3D_B8G8R8X8_UNORM_SRGB:
       case SVGA3D_B8G8R8A8_UNORM_SRGB:
       case SVGA3D_R8G8B8A8_UNORM_SRGB:
+      case SVGA3D_R8G8B8A8_UNORM: /* GB_RGBA_WINDOW: Android windows are RGBA_8888 */
          break;
 
       /* Often unsupported/problematic. This means we end up with the same
@@ -2351,6 +2353,7 @@ svga_is_dx_format_supported(struct pipe_screen *screen,
       case SVGA3D_B8G8R8X8_UNORM_SRGB:
       case SVGA3D_B8G8R8A8_UNORM_SRGB:
       case SVGA3D_R8G8B8A8_UNORM_SRGB:
+      case SVGA3D_R8G8B8A8_UNORM: /* GB_RGBA_WINDOW: Android windows are RGBA_8888 */
          break;
 
       /* Often unsupported/problematic. This means we end up with the same
diff --git a/src/gallium/drivers/svga/svga_screen.c b/src/gallium/drivers/svga/svga_screen.c
index 3efadd12012..489f51ecf90 100644
--- a/src/gallium/drivers/svga/svga_screen.c
+++ b/src/gallium/drivers/svga/svga_screen.c
@@ -14,6 +14,9 @@
 #include "util/u_screen.h"
 #include "util/u_string.h"
 #include "util/u_math.h"
+#include "util/disk_cache.h"
+#include "util/hex.h"
+#include "util/mesa-blake3.h"
 
 #include "svga_winsys.h"
 #include "svga_public.h"
@@ -736,6 +739,7 @@ svga_destroy_screen( struct pipe_screen *screen )
    struct svga_screen *svgascreen = svga_screen(screen);
 
    svga_screen_cache_cleanup(svgascreen);
+   disk_cache_destroy(svgascreen->disk_shader_cache);
 
    mtx_destroy(&svgascreen->swc_mutex);
    mtx_destroy(&svgascreen->tex_mutex);
@@ -755,6 +759,30 @@ svga_screen_get_fd( struct pipe_screen *screen )
 }
 
 
+/* GB_SHADER_CACHE: give st/mesa a disk cache so linked GLSL programs (and GL program binaries, used by HWUI's own
+ * shader cache) persist. On Android there is no writable cache dir, so it lives entirely in the EGL loader's
+ * per-app blob cache (EGL_ANDROID_blob_cache, which is only exposed when this hook exists). */
+static struct disk_cache *
+svga_get_disk_shader_cache(struct pipe_screen *pscreen)
+{
+   return svga_screen(pscreen)->disk_shader_cache;
+}
+
+static void
+svga_disk_cache_create(struct svga_screen *svgascreen)
+{
+   blake3_hasher ctx;
+   unsigned char blake3[BLAKE3_KEY_LEN];
+   char cache_id[BLAKE3_KEY_LEN * 2 + 1];
+
+   _mesa_blake3_init(&ctx);
+   if (!disk_cache_get_function_identifier(svga_disk_cache_create, &ctx))
+      return;
+   _mesa_blake3_final(&ctx, blake3);
+   mesa_bytes_to_hex(cache_id, blake3, BLAKE3_KEY_LEN);
+   svgascreen->disk_shader_cache = disk_cache_create("svga", cache_id, 0);
+}
+
 /**
  * Create a new svga_screen object
  */
@@ -788,6 +816,8 @@ svga_screen_create(struct svga_winsys_screen *sws)
    screen = &svgascreen->screen;
 
    screen->destroy = svga_destroy_screen;
+   screen->get_disk_shader_cache = svga_get_disk_shader_cache;
+   svga_disk_cache_create(svgascreen);
    screen->get_name = svga_get_name;
    screen->get_vendor = svga_get_vendor;
    screen->get_device_vendor = svga_get_vendor; // TODO actual device vendor
diff --git a/src/gallium/drivers/svga/svga_screen.h b/src/gallium/drivers/svga/svga_screen.h
index 27a8bf9f3f6..9bbbec09a4f 100644
--- a/src/gallium/drivers/svga/svga_screen.h
+++ b/src/gallium/drivers/svga/svga_screen.h
@@ -81,6 +81,9 @@ struct svga_screen
       uint64_t __pad[6];
       uint64_t num_resources;
    } hud;
+
+   /* GB_SHADER_CACHE: lets st/mesa cache linked programs (EGL_ANDROID_blob_cache on Android) */
+   struct disk_cache *disk_shader_cache;
 };
 
