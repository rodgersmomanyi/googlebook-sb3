# gb_power (source native/power/gb_power.c): combined battery via test_power, detach (DTX) handling and
# the latch lifecycle, dGPU runtime PM / hot-plug policy, platform profile, and the control socket
# /dev/socket/gb_power (C:\GB-build\native\dgpu\INTERFACES.md sections 9, 10, 15.2). Native tree only (gb.hw=native);
# append to GB_RC_NATIVE (/odm/etc/init/gb.rc).
# Started from early-init right after "exec_start gb_modules" (same trigger, parsed later, so it runs after the module
# loads finished): it flags/hides BAT1/BAT2 and fills test_battery before the health HAL (class hal, "on boot") scans
# /sys/class/power_supply. Not oneshot: init restarts it if it dies (a restart re-evaluates the latch: locked if a
# driver is bound to an NVIDIA function, else unlocked). It waits for the supplies/devices itself (uevents + retries),
# so no ordering on SAM probing is needed.
# socket: created by init (0666 root root, AF_UNIX stream); gb_power checks every peer with SO_PEERCRED and accepts
# only the fixed command set of INTERFACES 9.3 and 26.1. /dev/gb_dgpu holds the root-only per-boot flags.
# v1.2 (graphics switching, INTERFACES 22-26): no change to this file (15.2). The gfx_mode triggers, the
# gb_gfx_selftest service and /data/vendor/gb/selftest are in gb_nouveau.rc (15.1-v12); gb_power starts and stops
# gb_gfx_selftest, gb_nouveau and gb_nouveau_off through ctl.start/ctl.stop.
service gb_power /vendor/bin/gb_power
    user root
    group root system
    seclabel u:r:shell:s0
    socket gb_power stream 0666 root root
    stdio_to_kmsg
    disabled

# Platform profile from a property; gb_power -p validates it against platform_profile_choices (else balanced) and
# logs to kmsg. Usage: setprop persist.vendor.gb.perf_profile performance|balanced-performance|balanced|low-power
service gb_power_profile /vendor/bin/gb_power -p ${persist.vendor.gb.perf_profile}
    user root
    group root
    seclabel u:r:shell:s0
    stdio_to_kmsg
    oneshot
    disabled

on early-init
    mkdir /dev/gb_dgpu 0700 root root
    start gb_power

on property:persist.vendor.gb.perf_profile=*
    restart gb_power_profile
