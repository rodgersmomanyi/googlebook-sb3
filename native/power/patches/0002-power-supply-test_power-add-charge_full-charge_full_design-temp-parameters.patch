power: supply: test_power: add battery_charge_full, battery_charge_full_design and battery_temp parameters

test_power hard-codes charge_full = charge_full_design = 100 and temp = 26. The Android desktop health HAL derives
the level from charge_counter*100/charge_full and the time-to-full ETA from (charge_full - charge_counter) / current,
so a bridged battery needs real uAh values. Defaults keep the old values; writes raise power_supply_changed.
---
--- a/drivers/power/supply/test_power.c
+++ b/drivers/power/supply/test_power.c
@@ -35,6 +35,9 @@
 static int battery_voltage		= 3300;
 static int battery_charge_counter	= -1000;
 static int battery_current		= -1600;
+static int battery_charge_full		= 100;
+static int battery_charge_full_design	= 100;
+static int battery_temp			= 26;
 static enum power_supply_charge_behaviour battery_charge_behaviour =
 	POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO;
 static enum power_supply_charge_type battery_charge_types =
@@ -111,15 +114,17 @@
 		val->intval = battery_charge_counter;
 		break;
 	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		val->intval = battery_charge_full_design;
+		break;
 	case POWER_SUPPLY_PROP_CHARGE_FULL:
-		val->intval = 100;
+		val->intval = battery_charge_full;
 		break;
 	case POWER_SUPPLY_PROP_TIME_TO_EMPTY_AVG:
 	case POWER_SUPPLY_PROP_TIME_TO_FULL_NOW:
 		val->intval = 3600;
 		break;
 	case POWER_SUPPLY_PROP_TEMP:
-		val->intval = 26;
+		val->intval = battery_temp;
 		break;
 	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
 		val->intval = battery_voltage;
