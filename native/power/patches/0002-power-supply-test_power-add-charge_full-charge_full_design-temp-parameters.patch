+	return 0;
+}
+
+#define param_get_battery_temp param_get_int
+
 static int param_set_battery_extension(const char *key,
 				       const struct kernel_param *kp)
 {
@@ -699,6 +749,21 @@
 	.get = param_get_battery_current,
