# Surface Book 3 internal cameras (Ice Lake IPU4P 8086:8A19 + OV5693/OV8865/OV7251 + DW9719)
# Append to common/arch/x86/configs/gki_defconfig AFTER applying kernel/0001-camera-ipu4p-sb3.patch.
# All new code is modular; MEDIA_PCI_SUPPORT is only a menu guard (no vmlinux code).
CONFIG_MEDIA_PCI_SUPPORT=y
CONFIG_IPU_BRIDGE=m
CONFIG_VIDEO_INTEL_IPU6=m
# CONFIG_VIDEO_INTEL_IPU6_IPU7 is not set
CONFIG_INTEL_SKL_INT3472=m
CONFIG_VIDEO_OV5693=m
CONFIG_VIDEO_OV8865=m
CONFIG_VIDEO_OV7251=m
CONFIG_VIDEO_DW9719=m
# auto-selected by the sensor drivers: CONFIG_V4L2_CCI=m CONFIG_V4L2_CCI_I2C=m

# Native-platform prerequisites (sensor I2C bus + INT3472 GPIOs). Shared with other native
# components (e.g. the APDS9960 light sensor); skip any line another component already added.
# Lapis vendor_dlkm also ships these as modules, but ours must be present if the vendor copies
# are not loaded on the SB3.  Do NOT add I2C_DESIGNWARE_PCI (not needed for LPSS; it selects
# I2C_CCGX_UCSI = one more module to list).
# SB3 inventory: GPIO = ACPI\INT3455 (pinctrl-icelake); I2C = PCI 8086:34C5,34E8-34EB (LPSS PCI)
CONFIG_PINCTRL_ICELAKE=m
CONFIG_MFD_INTEL_LPSS_PCI=m
# I2C_DESIGNWARE_CORE is NOT auto-selected: it is a visible tristate and I2C_DESIGNWARE_PLATFORM
# sits inside "if I2C_DESIGNWARE_CORE" (6.18 drivers/i2c/busses/Kconfig). Without the CORE line,
# olddefconfig silently drops PLATFORM and the two i2c-designware .ko listed in bazel_modules.txt
# are never built (verifier fix, 2026-10-24).
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
# auto-selected: CONFIG_PINCTRL_INTEL=m CONFIG_MFD_INTEL_LPSS=m CONFIG_MFD_CORE=m

# Kleaf runs check_defconfig="minimized" (savedefconfig must equal gki_defconfig). After
# "make gki_defconfig" with the lines above, savedefconfig keeps exactly these camera lines:
#   CONFIG_I2C_DESIGNWARE_CORE=m, CONFIG_PINCTRL_ICELAKE=m, CONFIG_MFD_INTEL_LPSS_PCI=m,
#   CONFIG_MEDIA_PCI_SUPPORT=y, CONFIG_VIDEO_INTEL_IPU6=m, # CONFIG_VIDEO_INTEL_IPU6_IPU7 is not set,
#   CONFIG_IPU_BRIDGE=m, CONFIG_VIDEO_OV5693=m, CONFIG_VIDEO_OV7251=m, CONFIG_VIDEO_OV8865=m,
#   CONFIG_VIDEO_DW9719=m, CONFIG_INTEL_SKL_INT3472=m
# It drops CONFIG_I2C_DESIGNWARE_PLATFORM=m (the default once CORE=m) and the existing
# CONFIG_GPIOLIB=y line (pinctrl-intel selects it), so regenerate gki_defconfig with savedefconfig.
