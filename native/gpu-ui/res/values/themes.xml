<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform themes only (no AndroidX). The activities draw their own title. -->
    <style name="Theme.GbGpu" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- HoldersActivity: an invisible host for the AlertDialog. -->
    <style name="Theme.GbGpu.Translucent" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
