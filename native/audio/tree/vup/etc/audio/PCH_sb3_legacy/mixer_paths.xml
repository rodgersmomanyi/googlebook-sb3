<?xml version='1.0' encoding='utf-8'?>
<mixer enum_mixer_numeric_fallback="true">
	<!-- GB native FALLBACK (legacy snd-hda-intel). Missing controls are skipped by libaudioroute.
	     gb_audio.sh sets the codec volumes in percent. -->
	<ctl name="Master Playback Switch" value="1" />
	<ctl name="Speaker Playback Switch" value="1" />
	<ctl name="Headphone Playback Switch" value="1" />
	<ctl name="Auto-Mute Mode" value="Enabled" />
	<ctl name="Capture Switch" value="1" />
	<path name="Speaker">
		<ctl name="Speaker Playback Switch" value="1" />
	</path>
	<path name="Mic">
		<ctl name="Capture Switch" value="1" />
	</path>
	<path name="HDMI1" />
	<path name="HDMI2" />
	<path name="HDMI3" />
</mixer>
