<?xml version='1.0' encoding='utf-8'?>
<mixer enum_mixer_numeric_fallback="true">
	<!--
GB native: Surface Book 3, card sof-hda-dsp (libaudioroute format, read by DRAS).
libaudioroute skips controls that do not exist ("Control '%s' doesn't exist - skipping"), so the candidate
codec control names below are safe even where the ALC274 auto-parser names them differently.

SOF topology controls. Names and ranges are verified from sof-hda-generic-2ch/-4ch.tplg. ASoC names a
PGA kcontrol "<widget> <control>" because the topology has no SOF_TKN_COMP_NO_WNAME_IN_KCONTROL_NAME.
  playback PGAs: max 32, -64 dB + 2 dB/step, so 32 = 0 dB
  analog capture PGA: max 80, -50 dB + 1 dB/step, so 50 = 0 dB
  DMIC PGAs: max 70, -50 dB + 1 dB/step, so 50 = 0 dB and 60 = +10 dB
The HDA codec volumes have codec-specific ranges, so gb_audio.sh sets them in percent with tinymix.
Only the switches are set here.
-->
	<ctl name="PGA30.0 30 Playback Volume" value="32" />
	<ctl name="PGA31.0 31 Playback Volume" value="32" />
	<ctl name="PGA1.0 1 Master Playback Volume" value="32" />
	<ctl name="PGA2.0 2 Master Capture Volume" value="50" />
	<ctl name="PGA7.0 7 Master Playback Volume" value="32" />
	<ctl name="PGA8.0 8 Master Playback Volume" value="32" />
	<ctl name="PGA9.0 9 Master Playback Volume" value="32" />
	<ctl name="Dmic0 Capture Volume" value="50" />
	<ctl name="Dmic0 Capture Switch" value="1" />
	<ctl name="Dmic1 2nd Capture Volume" value="50" />
	<!-- Realtek ALC274 (snd-hda-codec-alc269, generic auto-parser). Auto-Mute mutes the speaker when the jack is
	     in, so speaker and headphone stay on in the base state. -->
	<ctl name="Master Playback Switch" value="1" />
	<ctl name="Speaker Playback Switch" value="1" />
	<ctl name="Headphone Playback Switch" value="1" />
	<ctl name="Auto-Mute Mode" value="Enabled" />
	<ctl name="Capture Switch" value="1" />
	<path name="Speaker">
		<ctl name="Speaker Playback Switch" value="1" />
	</path>
	<path name="Headphone">
		<ctl name="Headphone Playback Switch" value="1" />
	</path>
	<path name="InternalMic">
		<ctl name="Dmic0 Capture Switch" value="1" />
	</path>
	<path name="Mic">
		<ctl name="Capture Switch" value="1" />
	</path>
	<path name="HDMI1" />
	<path name="HDMI2" />
	<path name="HDMI3" />
</mixer>
