# NVK (Mesa Vulkan for the NVIDIA GTX 1650 in the performance base) - TEST ONLY. Native tree only (gb.hw=native);
# shipped through nvk.json "rc_files" (Wave 2). Nothing here makes NVK the system Vulkan driver: lapis keeps
# ro.hardware.vulkan=intel (ANV) for SurfaceFlinger, HWUI and ANGLE. /vendor/lib64/hw/vulkan.nouveau.so is only
# loaded by programs that dlopen it explicitly (nvk_probe, the compute service).
# Prerequisite: nouveau bound to the dGPU (vendor.gb.nouveau.result healthy/clean) and the base attached.
# Usage: setprop vendor.gb.nvk_probe 1   -> result in /data/vendor/nvk/probe.txt (+ probe.ppm) and in kmsg on failure.
# The anb-*, ahb-i915-readback and a17-swapchain-model tests import i915 (minigbm) buffers into nouveau, so the run
# first marks this boot "foreign" (monotonic, INTERFACES 4 / D9): gb_nouveau.sh off will then unbind but never rmmod.
# The probe runs as user shell in group graphics, not as root (INTERFACES 15.5): the nouveau render node is
# 0660 root:graphics, so the chmod 000 that gb_power's detach and gb_nouveau.sh off apply before their refcnt gate
# really keeps it out (root ignores mode bits). Its output directory belongs to shell, so no root process writes
# through a path that shell controls. gb_power and gb_nouveau.sh off also stop this service before the gate.
service gb_nvk_probe /system/bin/sh -c "/vendor/bin/nvk_probe -n 200 -o /data/vendor/nvk/probe.ppm > /data/vendor/nvk/probe.txt 2>&1; echo nvk_probe exit=$$? >> /data/vendor/nvk/probe.txt"
    user shell
    group shell graphics
    seclabel u:r:shell:s0
    stdio_to_kmsg
    oneshot
    disabled

on post-fs-data
    mkdir /data/vendor/nvk 0770 shell shell

on property:vendor.gb.nvk_probe=1
    setprop vendor.gb.nvk_probe 0
    setprop vendor.gb.nouveau.foreign 1
    write /dev/gb_dgpu/foreign 1
    start gb_nvk_probe
