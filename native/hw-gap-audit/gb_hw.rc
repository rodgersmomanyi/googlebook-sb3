# gb_hw (source C:\GB-build\native\hw-gap-audit\tree\gb_hw.sh): Surface Book 3 native-mode hardware glue.
# Native tree only (gb.hw=native): append to GB_RC_NATIVE (/odm/etc/init/gb.rc), install gb_hw.sh as /odm/gb_hw.sh.
# 1. early-init: snapshot the firmware CPU package power limits (MSR 0x610) before lapis init.lapis.rc 'on init'
#    overwrites them with the lapis board's PL1=25 W / PL2=55 W.
# 2. on boot: put the firmware limits back (persist.vendor.gb.rapl.mode=fw|lapis|custom, default fw) and let the
#    composer (user system) write any backlight (lapis only chowns intel_backlight).
# 3. boot_completed: re-apply the limits once more and log a hardware summary to kmsg (picked up by gb_bootlog).
# 4. on boot, own service: bind the power button / volume rocker (MSHW0040) to soc_button_array once lapis's
#    pinctrl-icelake drives the INT3455 GPIO controller (readiness A-H1; bounded, idempotent, never blocks boot).
# 5. boot_completed with vendor.gb.posture / persist.vendor.gb.posture set: opt-in device-state override (A-M1).
# 6. on boot, own service: bind the Surface Aggregator serial device (MSHW0084) to surface_serial_hub again once the
#    INT3455 GPIO controller has its driver (k16's first-stage probe fails with -EINVAL), then wait for its clients
#    (wave 9 hw-native1; bounded, idempotent, never blocks boot).
# 7. early-boot, own service: one reset + re-bind of the Integrated Sensor Hub if lapis's coldboot probe failed, while
#    gb_sensors_wait (sensors component, after this one in gb.rc) holds the sensors HAL back (wave 9 hw-native1).
# 8. early-init, own service: load the rear camera's focus-motor driver dw9719.ko once ipu-bridge has created the
#    motor's device and its runtime-PM link to the rear sensor, so the sensor powers the motor for its probe and
#    its first runtime suspend (wave 10 misc-cameras; bounded, idempotent, never blocks boot).
service gb_hw_rapl_snap /system/bin/sh /odm/gb_hw.sh rapl-snapshot
    user root
    group root
    seclabel u:r:shell:s0
    stdio_to_kmsg
    oneshot
    disabled

service gb_hw_boot /system/bin/sh /odm/gb_hw.sh boot
    user root
    group root system
    seclabel u:r:shell:s0
    stdio_to_kmsg
    oneshot
    disabled

service gb_hw_diag /system/bin/sh /odm/gb_hw.sh diag
    user root
    group root system log readproc
    seclabel u:r:shell:s0
    stdio_to_kmsg
    oneshot
    disabled

service gb_hw_buttons /system/bin/sh /odm/gb_hw.sh buttons
    user root
    group root
    seclabel u:r:shell:s0
    stdio_to_kmsg
    oneshot
    disabled

service gb_hw_posture /system/bin/sh /odm/gb_hw.sh posture
    user root
    group root system
    seclabel u:r:shell:s0
    stdio_to_kmsg
    oneshot
    disabled

service gb_hw_sam /system/bin/sh /odm/gb_hw.sh sam
    user root
    group root
    seclabel u:r:shell:s0
    stdio_to_kmsg
    oneshot
    disabled

service gb_hw_ish /system/bin/sh /odm/gb_hw.sh ish
    user root
    group root
    seclabel u:r:shell:s0
    stdio_to_kmsg
    oneshot
    disabled

service gb_hw_vcm /system/bin/sh /odm/gb_hw.sh vcm
    user root
    group root
    seclabel u:r:shell:s0
    stdio_to_kmsg
    oneshot
    disabled

on early-init
    exec_start gb_hw_rapl_snap
    start gb_hw_vcm

on early-boot
    start gb_hw_ish

on boot
    start gb_hw_boot
    start gb_hw_buttons
    start gb_hw_sam

on property:sys.boot_completed=1
    start gb_hw_diag

on property:persist.vendor.gb.rapl.mode=*
    start gb_hw_boot

on property:sys.boot_completed=1 && property:vendor.gb.posture=*
    start gb_hw_posture

on property:sys.boot_completed=1 && property:persist.vendor.gb.posture=*
    start gb_hw_posture

# 9. (wave 11 power-drain) boot_completed, own services: 'power' measures the power draw in windows late in the boot
#    (read-only; persist.vendor.gb.power.measure=0 turns it off; vendor.gb.power.now=1 measures one window now);
#    'pwrpolicy' (pwr.policy=1: EPP / battery PL1 cap / battery platform profile per power source) and 'pmtune'
#    (pm.tune=1: NMI watchdog off, runtime PM auto for PCI USB/audio/IPU) are opt-in: without their property they log
#    one line and exit. All four: disabled oneshot root services in u:r:shell:s0, only ever started with 'start'.
service gb_hw_power /system/bin/sh /odm/gb_hw.sh power
    user root
    group root system log readproc
    seclabel u:r:shell:s0
    stdio_to_kmsg
    oneshot
    disabled

service gb_hw_power_now /system/bin/sh /odm/gb_hw.sh power-now
    user root
    group root system log readproc
    seclabel u:r:shell:s0
    stdio_to_kmsg
    oneshot
    disabled

service gb_hw_pwrpolicy /system/bin/sh /odm/gb_hw.sh pwrpolicy
    user root
    group root system
    seclabel u:r:shell:s0
    stdio_to_kmsg
    oneshot
    disabled

service gb_hw_pmtune /system/bin/sh /odm/gb_hw.sh pmtune
    user root
    group root system
    seclabel u:r:shell:s0
    stdio_to_kmsg
    oneshot
    disabled

on property:sys.boot_completed=1
    start gb_hw_power
    start gb_hw_pwrpolicy
    start gb_hw_pmtune

on property:sys.boot_completed=1 && property:vendor.gb.power.now=1
    start gb_hw_power_now

on property:sys.boot_completed=1 && property:persist.vendor.gb.pwr.policy=1
    start gb_hw_pwrpolicy
