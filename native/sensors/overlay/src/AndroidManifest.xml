<?xml version="1.0" encoding="utf-8"?>
<!-- Googlebook SB3 native: re-enable auto-rotate and adaptive brightness, which the lapis vendor RRO
     (framework-res__lapis__auto_generated_rro_vendor.apk, priority 0) switches off because lapis has no
     accelerometer/light sensor. Static vendor RRO, higher priority, same target/SDK as the lapis one. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="android.gb_sb3_sensors_rro_vendor__"
    android:versionCode="1"
    android:versionName="1.0">
    <application android:hasCode="false" />
    <overlay android:targetPackage="android"
        android:isStatic="true"
        android:priority="10" />
</manifest>
