From: Googlebook SB3 native bring-up <gb-sb3@localhost>
Date: Sat, 24 Oct 2026 19:00:00 +0000
Subject: [PATCH 1/2] iio: hid-sensors: present ISH accel/gyro as cros-ec-accel/cros-ec-gyro for the Android IIO sensors HAL

The lapis sensors sub-HAL (android.hardware.sensors@2.1-Desktop-IIO-Subhal.so) only accepts IIO
devices named like ChromeOS EC sensors and decodes samples the cros_ec_sensors way: s16 channels packed
in the first 8 bytes of a 16-byte scan, CLOCK_BOOTTIME timestamp in the last 8 bytes, one shared
"scale" and "sampling_frequency" (+_available), label accel-display/accel-base, Android axis signs.
With android=1 (default) hid-sensor-accel-3d (usage 0x200073 only; gravity keeps its ABI) and
hid-sensor-gyro-3d register as cros-ec-accel / cros-ec-gyro with that layout: samples are converted to
s16 counts (accel 1/4096 g, gyro 1 mrad/s), axes remapped by android_axes (accel default -x,-y,-z: HID/Windows gravity sign), timestamps
from ktime_get_boottime_ns(), change sensitivity set to 0, 0 Hz writes ignored. android=0 restores
the upstream ABI. Parameters: android, android_label, android_axes (0644), android_hyst0.
---
 3 files changed, 441 insertions(+), 13 deletions(-)
 drivers/iio/common/hid-sensors/hid-sensor-android.h
 drivers/iio/accel/hid-sensor-accel-3d.c
 drivers/iio/gyro/hid-sensor-gyro-3d.c

diff --git a/drivers/iio/common/hid-sensors/hid-sensor-android.h b/drivers/iio/common/hid-sensors/hid-sensor-android.h
new file mode 100644
--- /dev/null
+++ b/drivers/iio/common/hid-sensors/hid-sensor-android.h
@@ -0,0 +1,195 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Android "cros-ec" presentation of HID sensor hub IIO devices.
+ *
+ * The Android desktop IIO sensors sub-HAL (android.hardware.sensors@2.1-Desktop-IIO-Subhal.so)
+ * only accepts IIO devices whose name is one of the ChromeOS EC sensor names (cros-ec-accel,
+ * cros-ec-gyro, cros-ec-light, ...), and it decodes buffered samples the way cros_ec_sensors
+ * lays them out:
+ *  - every data channel is a signed 16-bit value; the channel with scan index i is taken from
+ *    bits [16*i, 16*i+16) of the first 8 bytes of a 16-byte scan (it ignores realbits/storagebits),
+ *  - the timestamp is the last 8 bytes of that 16-byte scan and is used as the Android event
+ *    timestamp, so it must be CLOCK_BOOTTIME nanoseconds,
+ *  - value = raw * <the attribute whose name ends in "scale">, in Android units and Android axis
+ *    convention (accelerometer reads +9.81 on the axis pointing up),
+ *  - the label "accel-display" / "accel-base" gives the sensor location; only an "accel-display"
+ *    accelerometer gets the derived device-orientation (auto-rotate) sensor,
+ *  - the rate is set through files ending in "sampling_frequency"; ueventd only makes the plain
+ *    "sampling_frequency" file writable for the HAL (user system), so it must be shared_by_all.
+ *
+ * HID sensors (Intel ISH on the Surface Book 3) report 32-bit fields, in Windows axis
+ * convention, with the ISH's own timestamps. In Android mode the drivers convert each sample to
+ * the layout above. Android mode is the default (module parameter android=1); android=0 gives
+ * the stock upstream ABI. The axis mapping is the runtime-writable parameter android_axes
+ * (accelerometer "-x,-y,-z": HID/Windows report gravity as -1 g on the axis pointing up, Android
+ * as +9.81; gyroscope "x,y,z": both use the right-hand rule on the same display-aligned axes).
+ */
+#ifndef _HID_SENSOR_ANDROID_H
+#define _HID_SENSOR_ANDROID_H
+
+#include <linux/bits.h>
+#include <linux/compiler.h>
+#include <linux/errno.h>
+#include <linux/iio/iio.h>
+#include <linux/kernel.h>
+#include <linux/limits.h>
+#include <linux/math64.h>
+#include <linux/minmax.h>
+#include <linux/moduleparam.h>
+#include <linux/overflow.h>
+#include <linux/time64.h>
+#include <linux/timekeeping.h>
+#include <linux/unaligned.h>
+#include <asm/page.h>
+
+/* Advertised rates (Hz) as IIO_VAL_INT_PLUS_MICRO pairs. The HAL derives minDelay/maxDelay from them. */
+static const int hid_sensor_android_freq_avail[] = {
+	1, 0,
+	5, 0,
+	10, 0,
+	25, 0,
+	50, 0,
+	100, 0,
+};
+
+/* Scan buffer pushed in Android mode: x, y, z as s16, timestamp in the last 8 bytes (16 bytes total). */
+struct hid_sensor_android_scan {
+	s16 val[3];
+	aligned_s64 timestamp;
+};
+
+#define HID_SENSOR_ANDROID_CHANNEL(_type, _mod, _si) {				\
+	.type = (_type),							\
+	.modified = 1,								\
+	.channel2 = (_mod),							\
+	.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),				\
+	.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_HYSTERESIS),		\
+	.info_mask_shared_by_all = BIT(IIO_CHAN_INFO_SCALE) |			\
+				   BIT(IIO_CHAN_INFO_SAMP_FREQ),		\
+	.info_mask_shared_by_all_available = BIT(IIO_CHAN_INFO_SAMP_FREQ),	\
+	.scan_index = (_si),							\
+	.scan_type = {								\
+		.sign = 's',							\
+		.realbits = 16,							\
+		.storagebits = 16,						\
+		.endianness = IIO_CPU,						\
+	},									\
+}
+
+/* Only the full x|y|z set is ever captured; the IIO core demuxes for partial users. */
+static const unsigned long hid_sensor_android_scan_masks[] = { 0x7, 0 };
+
+/* Read one HID input field of raw_len bytes and sign-extend it when the field is signed. */
+static inline s32 hid_sensor_android_get_raw(const char *raw_data, size_t raw_len,
+					     bool is_signed)
+{
+	switch (raw_len) {
+	case 1:
+		return is_signed ? (s32)(s8)raw_data[0] : (s32)(u8)raw_data[0];
+	case 2:
+		return is_signed ? (s32)(s16)get_unaligned_le16(raw_data) :
+				   (s32)get_unaligned_le16(raw_data);
+	default:
+		return (s32)get_unaligned_le32(raw_data);
+	}
+}
+
+/*
+ * Convert a raw HID value to an s16 count of lsb_nano (Android SI unit * 1e-9 per count).
+ * scale_int/scale_nano is the driver's HID scale (raw -> SI), IIO_VAL_INT_PLUS_NANO.
+ */
+static inline s16 hid_sensor_android_to_s16(s32 raw, int scale_int, int scale_nano,
+					    s64 lsb_nano, bool negate)
+{
+	s64 scale = (s64)scale_int * NSEC_PER_SEC + scale_nano;
+	s64 v;
+
+	if (check_mul_overflow((s64)raw, scale, &v))
+		v = ((raw < 0) != (scale < 0)) ? S64_MIN : S64_MAX;
+	else if (v >= 0)
+		v = div64_s64(v + lsb_nano / 2, lsb_nano);
+	else
+		v = div64_s64(v - lsb_nano / 2, lsb_nano);
+	if (negate)
+		v = (v == S64_MIN) ? S64_MAX : -v;
+
+	return (s16)clamp_t(s64, v, S16_MIN, S16_MAX);
+}
+
+static inline s64 hid_sensor_android_timestamp(void)
+{
+	return ktime_get_boottime_ns();
+}
+
+/*
+ * Axis mapping (module parameter "android_axes", e.g. "-x,-y,-z"): Android axis i takes HID axis
+ * SRC(i), negated if NEG(i). Packed into a u32 so the sample path reads it with one READ_ONCE():
+ * bits [2i+1:2i] = source axis, bit 6+i = negate.
+ */
+#define HID_SENSOR_ANDROID_AXES(s0, s1, s2, n0, n1, n2)			\
+	((s0) | ((s1) << 2) | ((s2) << 4) | ((n0) << 6) | ((n1) << 7) | ((n2) << 8))
+#define HID_SENSOR_ANDROID_AXIS_SRC(axes, i)	(((axes) >> (2 * (i))) & 3)
+#define HID_SENSOR_ANDROID_AXIS_NEG(axes, i)	(((axes) >> (6 + (i))) & 1)
+
+static inline int hid_sensor_android_axes_parse(const char *s, u32 *axes)
+{
+	unsigned int used = 0, n = 0, neg = 0;
+	u32 v = 0;
+
+	for (; *s && *s != '\n'; s++) {
+		if (*s == ',' || *s == ' ' || *s == '+')
+			continue;
+		if (*s == '-') {
+			neg = 1;
+			continue;
+		}
+		if (*s < 'x' || *s > 'z' || n >= 3 || (used & BIT(*s - 'x')))
+			return -EINVAL;
+		used |= BIT(*s - 'x');
+		v |= (u32)(*s - 'x') << (2 * n);
+		v |= (u32)neg << (6 + n);
+		neg = 0;
+		n++;
+	}
+	if (n != 3)
+		return -EINVAL;
+	*axes = v;
+	return 0;
+}
+
+static inline int hid_sensor_android_axes_print(char *buf, u32 axes)
+{
+	int i, len = 0;
+
+	for (i = 0; i < 3; i++)
+		len += scnprintf(buf + len, PAGE_SIZE - len, "%s%s%c", i ? "," : "",
+				 HID_SENSOR_ANDROID_AXIS_NEG(axes, i) ? "-" : "",
+				 'x' + HID_SENSOR_ANDROID_AXIS_SRC(axes, i));
+	len += scnprintf(buf + len, PAGE_SIZE - len, "\n");
+	return len;
+}
+
+/* Declares the runtime-writable "android_axes" parameter of a driver, backed by u32 <var>. */
+#define HID_SENSOR_ANDROID_AXES_PARAM(var, desc)				\
+static int var##_set(const char *val, const struct kernel_param *kp)		\
+{										\
+	u32 a;									\
+	int ret = hid_sensor_android_axes_parse(val, &a);			\
+										\
+	if (ret)								\
+		return ret;							\
+	WRITE_ONCE(var, a);							\
+	return 0;								\
+}										\
+static int var##_get(char *buf, const struct kernel_param *kp)		\
+{										\
+	return hid_sensor_android_axes_print(buf, READ_ONCE(var));		\
+}										\
+static const struct kernel_param_ops var##_ops = {				\
+	.set = var##_set,							\
+	.get = var##_get,							\
+};										\
+module_param_cb(android_axes, &var##_ops, NULL, 0644);				\
+MODULE_PARM_DESC(android_axes, desc)
+
+#endif
