+/* opt-in nouveau: persist.vendor.gb.nouveau=1 keeps a nouveau-bound dGPU bound (and its power/control untouched)
+ * outside a detach; a detach still unbinds it, with an extra heartbeat; another driver is still unbound. */
+static void test_dgpu_keep(void) {
+  set_root("tree_pci_keep");
+  fake_pci();
+  prop_set("persist.vendor.gb.nouveau", "1");
+  CHECK(dgpu_scan("hot-plug", 1) == 0, "kept driver not counted as busy");
+  CHECK(!strcmp(get("/sys/bus/pci/drivers/nouveau/unbind"), ""), "nouveau left bound: '%s'", get("/sys/bus/pci/drivers/nouveau/unbind"));
+  CHECK(!strcmp(get("/sys/devices/pci0000:00/0000:00:1d.4/0000:02:00.0/power/control"), "on"), "kept dGPU power/control untouched");
+  CHECK(!strcmp(get("/sys/devices/pci0000:00/0000:00:1d.4/0000:02:00.1/power/control"), "auto"), "unbound function still rpm auto");
+  CHECK(!strcmp(get("/sys/devices/pci0000:00/0000:00:1d.4/power/control"), "auto"), "root port rpm auto (keep)");
+  CHECK(!strcmp(g_keep_drv, "nouveau"), "keep driver from property: '%s'", g_keep_drv);
+  /* a different driver on the dGPU is still unbound */
+  put("/sys/bus/pci/drivers/nvidiafb/unbind", "");
+  lnk("../../../../bus/pci/drivers/nvidiafb", "/sys/devices/pci0000:00/0000:00:1d.4/0000:02:00.0/driver");
+  CHECK(dgpu_scan("hot-plug", 0) == 0 && !strcmp(get("/sys/bus/pci/drivers/nvidiafb/unbind"), "0000:02:00.0"), "other driver unbound");
+  lnk("../../../../bus/pci/drivers/nouveau", "/sys/devices/pci0000:00/0000:00:1d.4/0000:02:00.0/driver");
+  /* detach: nouveau is unbound before LATCH_CONFIRM, with a second heartbeat */
+  set_root("tree_dtx_keep");
+  fake_input();
+  fake_pci();
+  put("/dev/surface/dtx", "");
+  dtx_ioctl = mock_ioctl;
+  memset(&ec, 0, sizeof ec);
+  ec.base = SDTX_BASE_ATTACHED; ec.latch = SDTX_LATCH_CLOSED; ec.mode = MODE_LAPTOP;
+  g_dtx.fd = -1;
+  CHECK(dtx_open() == 0 && g_dtx.fd >= 0, "dtx open (keep)");
+  ec.log[0] = 0;
+  ev(SDTX_EVENT_REQUEST, 0);
+  CHECK(!strcmp(ec.log, "HB HB CONFIRM "), "keep: detach confirmed after unbind: '%s'", ec.log);
+  CHECK(!strcmp(get("/sys/bus/pci/drivers/nouveau/unbind"), "0000:02:00.0"), "keep: nouveau unbound before confirm");
+  dtx_close();
+  dtx_ioctl = sys_ioctl;
+  /* -K on the command line wins over the property; property 0 -> default behaviour */
+  prop_set("persist.vendor.gb.nouveau", "0");
+  keep_drv_update();
+  CHECK(g_keep_drv[0] == 0, "property 0 -> no keep");
+  g_keep_cli = 1; snprintf(g_keep_drv, sizeof g_keep_drv, "nouveau");
+  keep_drv_update();
+  CHECK(!strcmp(g_keep_drv, "nouveau"), "-K overrides property");
+  g_keep_cli = 0; g_keep_drv[0] = 0;
+}
