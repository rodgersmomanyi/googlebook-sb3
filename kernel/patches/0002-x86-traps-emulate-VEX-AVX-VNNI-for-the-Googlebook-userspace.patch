Subject: [PATCH] x86/traps: emulate VEX-encoded AVX-VNNI (#UD handler)

lapis userspace is built for CPUs with AVX-VNNI and executes vpdpbusd/vpdpbusds/vpdpwssd/vpdpwssds
unconditionally; Ice Lake (and the VMware guest, whose CPUID masks VNNI) raises #UD. handle_invalid_op() now
emulates the VEX 0F38 50..53 forms (128/256-bit, register and memory operands) for user mode and skips the
instruction. Marker GB_VNNI_EMULATION. Generated by kernel/scripts/apply_vnni3.py (apply_vnni_patch.py was the
first, 128-bit register-only version).
Known gap (prior-art research): lapis's libinput also uses VEX AVX-IFMA, which this does not emulate.

Base: AOSP kernel/common android17-6.18-2026-06 at 3938c8d97142d5cf31543aa96f864a2cf832dda0 (kernel 6.18.21, ab/16302624;
     the full pin is kernel/manifest_16302624.xml). Apply in common/ with: git apply <this file>
License: GPL-2.0 (derived from Linux)
---
diff --git a/arch/x86/kernel/traps.c b/arch/x86/kernel/traps.c
index 6b22611e69cc..0db2d958276c 100644
--- a/arch/x86/kernel/traps.c
+++ b/arch/x86/kernel/traps.c
@@ -295,12 +295,166 @@ DEFINE_IDTENTRY(exc_overflow)
 	do_error_trap(regs, 0, "overflow", X86_TRAP_OF, SIGSEGV, 0, NULL);
 }
 
+
+/* GB_VNNI_EMULATION: emulate VEX-encoded AVX-VNNI (128/256-bit, reg-reg + memory) absent on this host. */
+#include <asm/fpu/types.h>
+#include <asm/fpu/xstate.h>
+extern void *get_xsave_addr(struct xregs_state *xsave, int xfeature_nr);
+static s32 gb_sat_s32(s64 v)
+{
+	if (v > (s64)S32_MAX) return S32_MAX;
+	if (v < (s64)S32_MIN) return S32_MIN;
+	return (s32)v;
+}
+static u64 gb_gpr(struct pt_regs *regs, int n)
+{
+	switch (n) {
+	case 0: return regs->ax;  case 1: return regs->cx;  case 2: return regs->dx;  case 3: return regs->bx;
+	case 4: return regs->sp;  case 5: return regs->bp;  case 6: return regs->si;  case 7: return regs->di;
+	case 8: return regs->r8;  case 9: return regs->r9;  case 10: return regs->r10; case 11: return regs->r11;
+	case 12: return regs->r12; case 13: return regs->r13; case 14: return regs->r14; case 15: return regs->r15;
+	}
+	return 0;
+}
+static void gb_vnni_lanes(u8 op, u32 *d, const u32 *a, const u32 *c, int ndw)
+{
+	int i, k;
+	for (i = 0; i < ndw; i++) {
+		s64 acc = (s32)d[i];
+		if (op >= 0x52) {
+			const s16 *aw = (const s16 *)&a[i];
+			const s16 *bw = (const s16 *)&c[i];
+			acc += (s32)aw[0] * (s32)bw[0];
+			acc += (s32)aw[1] * (s32)bw[1];
+		} else {
+			const u8 *ab = (const u8 *)&a[i];
+			const s8 *bb = (const s8 *)&c[i];
+			for (k = 0; k < 4; k++)
+				acc += (s32)ab[k] * (s32)bb[k];
+		}
+		if (op == 0x51 || op == 0x53)
+			d[i] = (u32)gb_sat_s32(acc);
+		else
+			d[i] = (u32)(s32)acc;
+	}
+}
+static noinline bool gb_emulate_vnni(struct pt_regs *regs)
+{
+	u8 ib[11];
+	u8 p0, p1, op, modrm;
+	int mod, L, dst, src1, src2, Rx, Bx, Xx, rm, ndw, len, i;
+	u32 d[8], a[8], c[8];
+	u32 *xmm; void *ymm = NULL;
+
+	if (!user_mode(regs))
+		return false;
+	if (copy_from_user(ib, (const void __user *)regs->ip, 5))
+		return false;
+	if (ib[0] != 0xc4)
+		return false;
+	p0 = ib[1]; p1 = ib[2]; op = ib[3]; modrm = ib[4];
+	if ((p0 & 0x1f) != 0x02)
+		return false;
+	if ((p1 & 0x03) != 0x01)
+		return false;
+	if (op < 0x50 || op > 0x53)
+		return false;
+	mod = (modrm >> 6) & 3;
+	L = (p1 >> 2) & 1;
+	ndw = L ? 8 : 4;
+	Rx = ((p0 >> 7) & 1) ^ 1;
+	Xx = ((p0 >> 6) & 1) ^ 1;
+	Bx = ((p0 >> 5) & 1) ^ 1;
+	src1 = (~(p1 >> 3)) & 0x0f;
+	dst  = ((modrm >> 3) & 7) | (Rx << 3);
+	rm = modrm & 7;
+	src2 = -1;
+	memset(c, 0, sizeof(c));
+
+	if (mod == 3) {
+		src2 = rm | (Bx << 3);
+		len = 5;
+	} else {
+		int base = -1, index = -1, scale = 0;
+		s64 disp = 0;
+		bool rip = false;
+		u64 ea = 0;
+		if (copy_from_user(&ib[5], (const void __user *)(regs->ip + 5), 6))
+			return false;
+		i = 5;
+		if (rm == 4) {
+			u8 sib = ib[5]; i = 6;
+			scale = (sib >> 6) & 3;
+			index = ((sib >> 3) & 7) | (Xx << 3);
+			base  = (sib & 7) | (Bx << 3);
+			if (((sib >> 3) & 7) == 4 && Xx == 0)
+				index = -1;
+			if ((sib & 7) == 5 && mod == 0) {
+				base = -1;
+				disp = (s32)(ib[6] | (ib[7] << 8) | (ib[8] << 16) | (ib[9] << 24));
+				i = 10;
+			}
+		} else if (rm == 5 && mod == 0) {
+			rip = true;
+			disp = (s32)(ib[5] | (ib[6] << 8) | (ib[7] << 16) | (ib[8] << 24));
+			i = 9;
+		} else {
+			base = rm | (Bx << 3);
+		}
+		if (mod == 1) { disp = (s8)ib[i]; i += 1; }
+		else if (mod == 2) { disp = (s32)(ib[i] | (ib[i+1] << 8) | (ib[i+2] << 16) | (ib[i+3] << 24)); i += 4; }
+		len = i;
+		if (base >= 0) ea += gb_gpr(regs, base);
+		if (index >= 0) ea += gb_gpr(regs, index) << scale;
+		ea += (u64)disp;
+		if (rip) ea += regs->ip + len;
+		if (copy_from_user(c, (const void __user *)ea, ndw * 4))
+			return false;
+	}
+
+	kernel_fpu_begin();
+	xmm = x86_task_fpu(current)->fpstate->regs.xsave.i387.xmm_space;
+	if (L)
+		ymm = get_xsave_addr(&x86_task_fpu(current)->fpstate->regs.xsave, XFEATURE_YMM);
+	memcpy(&d[0], &xmm[dst * 4], 16);
+	memcpy(&a[0], &xmm[src1 * 4], 16);
+	if (src2 >= 0)
+		memcpy(&c[0], &xmm[src2 * 4], 16);
+	if (L) {
+		if (ymm) {
+			memcpy(&d[4], (u8 *)ymm + dst * 16, 16);
+			memcpy(&a[4], (u8 *)ymm + src1 * 16, 16);
+			if (src2 >= 0)
+				memcpy(&c[4], (u8 *)ymm + src2 * 16, 16);
+		} else {
+			memset(&d[4], 0, 16);
+			memset(&a[4], 0, 16);
+			if (src2 >= 0)
+				memset(&c[4], 0, 16);
+		}
+	}
+	gb_vnni_lanes(op, d, a, c, ndw);
+	memcpy(&xmm[dst * 4], &d[0], 16);
+	if (L && ymm)
+		memcpy((u8 *)ymm + dst * 16, &d[4], 16);
+	x86_task_fpu(current)->fpstate->regs.xsave.header.xfeatures |= (1ULL << 1);
+	if (L && ymm)
+		x86_task_fpu(current)->fpstate->regs.xsave.header.xfeatures |= (1ULL << 2);
+	kernel_fpu_end();
+
+	regs->ip += len;
+	return true;
+}
+
 #ifdef CONFIG_X86_F00F_BUG
 void handle_invalid_op(struct pt_regs *regs)
 #else
 static inline void handle_invalid_op(struct pt_regs *regs)
 #endif
 {
+	if (gb_emulate_vnni(regs))
+		return;
+
 	do_error_trap(regs, 0, "invalid opcode", X86_TRAP_UD, SIGILL,
 		      ILL_ILLOPN, error_get_trap_addr(regs));
 }
