Subject: [PATCH] x86/traps: emulate VEX-encoded AVX-VNNI (#UD handler), v4

lapis userspace is built for CPUs with AVX-VNNI and executes vpdpbusd/vpdpbusds/vpdpwssd/vpdpwssds
unconditionally; Ice Lake (and the VMware guest, whose CPUID masks VNNI) raises #UD. handle_invalid_op() emulates
the VEX 0F38 50..53 forms (VEX.128/256, register and memory operands) for 64-bit user mode and skips the
instruction. Marker GB_VNNI_EMULATION. Generated by kernel/scripts/apply_vnni4.py (kernel build #15; the k13/k14
form was apply_vnni3.py, the first 128-bit register-only one apply_vnni_patch.py).
v4 (build #15): the user copies run with IRQs on (cond_local_irq_enable, as do_error_trap) and before
kernel_fpu_begin(); SSE/YMM/ZMM_Hi256 init state is honoured (a component is touched only when its XSTATE_BV bit
is set, YMM/ZMM_Hi256 bits are never set); VEX.128/256 zero the destination up to MAXVL; insn_fetch_from_user();
VEX.W1/no-AVX/uprobe-XOL refused; counter /sys/kernel/gb_vnni/{summary,reset}. Decode, lanes and the xstate merge
are in the new arch/x86/kernel/gb_vnni_core.h (host unit test: kernel/tools/test_gb_vnni_core.c).
Known gaps: lapis's libinput also uses VEX AVX-IFMA, which this does not emulate; legacy prefixes before VEX are
not emulated; a faulting memory operand gives SIGILL, not SIGSEGV; no debug trap after an emulated instruction
under single-step.
IRQ/ymm/xstate review from github.com/linuxkid473/gbos-x86 @f8a5c1a HANDOFF.md:59-62; code is ours.

Base: AOSP kernel/common android17-6.18-2026-06 at 3938c8d97142d5cf31543aa96f864a2cf832dda0 (kernel 6.18.21, ab/16302624;
     the full pin is kernel/manifest_16302624.xml). Apply in common/ with: git apply <this file>
License: GPL-2.0 (derived from Linux)
---
diff --git a/arch/x86/kernel/gb_vnni_core.h b/arch/x86/kernel/gb_vnni_core.h
new file mode 100644
index 000000000000..767969a8ad67
--- /dev/null
+++ b/arch/x86/kernel/gb_vnni_core.h
@@ -0,0 +1,254 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * GB_VNNI_EMULATION core (Googlebook SB3, kernel build #15): decode, dot-product lanes and xstate merge of the
+ * VEX-encoded AVX-VNNI instructions VPDPBUSD, VPDPBUSDS, VPDPWSSD and VPDPWSSDS (VEX.66.0F38.W0 50-53, VEX.128
+ * and VEX.256, register or memory source).
+ *
+ * No kernel-only calls: included by arch/x86/kernel/traps.c and by the host unit test
+ * kernel/tools/test_gb_vnni_core.c (KAT-0). The includer provides u8..u64, s8..s64, bool, NULL, S32_MIN,
+ * S32_MAX, memcpy() and memset(). Generated by kernel/scripts/apply_vnni4.py.
+ *
+ * xstate rules: a component is read or written only when its XSTATE_BV header bit is set. The YMM and ZMM_Hi256
+ * bits are never set here: when a bit is clear the buffer bytes are stale and the registers are architecturally
+ * zero. SSE in its init state is materialised as 16 zero registers before its bit is set. A VEX.128/VEX.256
+ * destination is zeroed above bit 127/255 up to MAXVL (bits 511:256 live in ZMM_Hi256).
+ *
+ * IRQ/ymm/xstate review from github.com/linuxkid473/gbos-x86 @f8a5c1a HANDOFF.md:59-62; code is ours.
+ */
+#ifndef _GB_VNNI_CORE_H
+#define _GB_VNNI_CORE_H
+
+#define GB_VNNI_XF_SSE		(1ULL << 1)	/* XFEATURE_SSE */
+#define GB_VNNI_XF_YMM		(1ULL << 2)	/* XFEATURE_YMM */
+#define GB_VNNI_XF_ZMM_HI256	(1ULL << 6)	/* XFEATURE_ZMM_Hi256 */
+
+/* gb_vnni_decode() results */
+#define GB_VNNI_OK		0
+#define GB_VNNI_NOT		1	/* not an encoding we emulate: SIGILL as before */
+#define GB_VNNI_SHORT		2	/* every fetched byte matches, but fewer than the length were fetched */
+
+/* gb_vnni_merge() result flags (counters) */
+#define GB_VNNI_F_SSE_INIT	1	/* SSE was in its init state */
+#define GB_VNNI_F_YMM_INIT	2	/* YMM was in its init state */
+#define GB_VNNI_F_ZMMHI		4	/* a ZMM_Hi256 slot was zeroed */
+
+struct gb_vnni_insn {
+	u8 op;		/* 0x50 vpdpbusd, 0x51 vpdpbusds, 0x52 vpdpwssd, 0x53 vpdpwssds */
+	u8 l;		/* VEX.L: 0 = 128-bit, 1 = 256-bit */
+	u8 dst;		/* ModRM.reg + VEX.R: accumulator and destination */
+	u8 src1;	/* VEX.vvvv: unsigned bytes (50/51) or signed words (52/53) */
+	s8 src2;	/* ModRM.rm + VEX.B: signed bytes or words; -1 = memory operand */
+	u8 len;		/* instruction length */
+	s8 base;	/* memory operand: base GPR 0-15, or -1 */
+	s8 index;	/* memory operand: index GPR 0-15, or -1 */
+	u8 scale;	/* memory operand: index shift 0-3 */
+	u8 rip;		/* memory operand: RIP-relative */
+	s32 disp;	/* memory operand: displacement */
+};
+
+/*
+ * Decode the n fetched bytes at the faulting ip. Only the 3-byte VEX prefix can encode map 0F38; legacy prefixes
+ * before it are not emulated. VEX.W1 is not AVX-VNNI and pp != 66 selects other instructions (AVX-VNNI-INT8).
+ */
+static inline int gb_vnni_decode(const u8 *ib, int n, struct gb_vnni_insn *in)
+{
+	u8 p0, p1, modrm, mod, rm, sib;
+	int r, x, b, len, i;
+
+	if (n < 1)
+		return GB_VNNI_SHORT;
+	if (ib[0] != 0xc4)
+		return GB_VNNI_NOT;
+	if (n < 2)
+		return GB_VNNI_SHORT;
+	if ((ib[1] & 0x1f) != 0x02)		/* m-mmmm: 0F38 */
+		return GB_VNNI_NOT;
+	if (n < 3)
+		return GB_VNNI_SHORT;
+	if ((ib[2] & 0x83) != 0x01)		/* W0, pp = 66 */
+		return GB_VNNI_NOT;
+	if (n < 4)
+		return GB_VNNI_SHORT;
+	if (ib[3] < 0x50 || ib[3] > 0x53)
+		return GB_VNNI_NOT;
+	if (n < 5)
+		return GB_VNNI_SHORT;
+
+	p0 = ib[1];
+	p1 = ib[2];
+	modrm = ib[4];
+	r = ((p0 >> 7) & 1) ^ 1;
+	x = ((p0 >> 6) & 1) ^ 1;
+	b = ((p0 >> 5) & 1) ^ 1;
+	mod = (modrm >> 6) & 3;
+	rm = modrm & 7;
+
+	in->op = ib[3];
+	in->l = (p1 >> 2) & 1;
+	in->src1 = (~(p1 >> 3)) & 0x0f;
+	in->dst = ((modrm >> 3) & 7) | (r << 3);
+	in->src2 = -1;
+	in->base = -1;
+	in->index = -1;
+	in->scale = 0;
+	in->rip = 0;
+	in->disp = 0;
+
+	if (mod == 3) {
+		in->src2 = rm | (b << 3);
+		in->len = 5;
+		return GB_VNNI_OK;
+	}
+
+	/* the length first, so that a short fetch is recognised before any byte past it is read */
+	len = 5;
+	if (rm == 4) {
+		if (n < 6)
+			return GB_VNNI_SHORT;
+		len = 6;
+		if ((ib[5] & 7) == 5 && mod == 0)
+			len += 4;		/* SIB base 101, mod 00: disp32, no base */
+	} else if (rm == 5 && mod == 0) {
+		len += 4;			/* RIP + disp32 */
+	}
+	if (mod == 1)
+		len += 1;
+	else if (mod == 2)
+		len += 4;
+	if (len > n)
+		return GB_VNNI_SHORT;
+	in->len = len;
+
+	i = 5;
+	if (rm == 4) {
+		sib = ib[5];
+		i = 6;
+		in->scale = (sib >> 6) & 3;
+		if (((sib >> 3) & 7) != 4 || x)	/* index 100 without VEX.X: none (r12 is valid) */
+			in->index = ((sib >> 3) & 7) | (x << 3);
+		if ((sib & 7) == 5 && mod == 0) {
+			in->disp = (s32)((u32)ib[6] | ((u32)ib[7] << 8) | ((u32)ib[8] << 16) | ((u32)ib[9] << 24));
+			i = 10;
+		} else {
+			in->base = (sib & 7) | (b << 3);
+		}
+	} else if (rm == 5 && mod == 0) {
+		in->rip = 1;
+		in->disp = (s32)((u32)ib[5] | ((u32)ib[6] << 8) | ((u32)ib[7] << 16) | ((u32)ib[8] << 24));
+		i = 9;
+	} else {
+		in->base = rm | (b << 3);
+	}
+	if (mod == 1)
+		in->disp = (s8)ib[i];
+	else if (mod == 2)
+		in->disp = (s32)((u32)ib[i] | ((u32)ib[i + 1] << 8) | ((u32)ib[i + 2] << 16) | ((u32)ib[i + 3] << 24));
+	return GB_VNNI_OK;
+}
+
+/* effective address (64-bit addressing); the caller passes the GPR values (0 when absent) and ip + len */
+static inline u64 gb_vnni_ea(const struct gb_vnni_insn *in, u64 base, u64 index, u64 next_ip)
+{
+	u64 ea = (u64)(s64)in->disp;
+
+	if (in->rip)
+		ea += next_ip;
+	if (in->base >= 0)
+		ea += base;
+	if (in->index >= 0)
+		ea += index << in->scale;
+	return ea;
+}
+
+static inline s32 gb_vnni_sat_s32(s64 v)
+{
+	if (v > (s64)S32_MAX)
+		return S32_MAX;
+	if (v < (s64)S32_MIN)
+		return S32_MIN;
+	return (s32)v;
+}
+
+/* d[i] += dot(a[i], c[i]) per dword; a = src1 (u8 or s16), c = src2 (s8 or s16); 51/53 saturate */
+static inline void gb_vnni_lanes(u8 op, u32 *d, const u32 *a, const u32 *c, int ndw)
+{
+	int i, k;
+
+	for (i = 0; i < ndw; i++) {
+		s64 acc = (s32)d[i];
+
+		if (op >= 0x52) {
+			for (k = 0; k < 2; k++)
+				acc += (s64)(s16)(a[i] >> (16 * k)) * (s16)(c[i] >> (16 * k));
+		} else {
+			for (k = 0; k < 4; k++)
+				acc += (s64)(u8)(a[i] >> (8 * k)) * (s8)(c[i] >> (8 * k));
+		}
+		if (op == 0x51 || op == 0x53)
+			d[i] = (u32)gb_vnni_sat_s32(acc);
+		else
+			d[i] = (u32)acc;
+	}
+}
+
+/*
+ * Execute the decoded instruction on a task's saved register image.
+ *   mem:       the memory source (16 or 32 bytes) when in->src2 < 0, else unused
+ *   xmm:       the legacy XMM0-15 area (i387.xmm_space, 64 dwords; fixed offset in every XSAVE format)
+ *   xfeatures: the XSAVE header XSTATE_BV
+ *   ymm, zhi:  the YMM (16 x 16 B) and ZMM_Hi256 (16 x 32 B) components, or NULL; ignored when their header bit
+ *              is clear
+ * Returns GB_VNNI_F_* flags.
+ */
+static inline unsigned int gb_vnni_merge(const struct gb_vnni_insn *in, const u32 *mem, u32 *xmm, u64 *xfeatures,
+					 u8 *ymm, u8 *zhi)
+{
+	u32 d[8], a[8], c[8];
+	u64 xf = *xfeatures;
+	unsigned int fl = 0;
+	int ndw = in->l ? 8 : 4;
+
+	if (!(xf & GB_VNNI_XF_YMM))
+		ymm = NULL;
+	if (!(xf & GB_VNNI_XF_ZMM_HI256))
+		zhi = NULL;
+	if (!(xf & GB_VNNI_XF_SSE)) {		/* init state: XMM0-15 are 0, the buffer bytes are stale */
+		memset(xmm, 0, 16 * 16);
+		*xfeatures = xf | GB_VNNI_XF_SSE;	/* safe: the whole XMM area is now valid */
+		fl |= GB_VNNI_F_SSE_INIT;
+	}
+	if (!ymm)
+		fl |= GB_VNNI_F_YMM_INIT;
+
+	memset(d, 0, sizeof(d));
+	memset(a, 0, sizeof(a));
+	memset(c, 0, sizeof(c));
+	memcpy(&d[0], &xmm[in->dst * 4], 16);
+	memcpy(&a[0], &xmm[in->src1 * 4], 16);
+	if (in->src2 >= 0)
+		memcpy(&c[0], &xmm[in->src2 * 4], 16);
+	else
+		memcpy(c, mem, ndw * 4);
+	if (in->l && ymm) {			/* without ymm the upper halves of d, a (and a register c) are 0 */
+		memcpy(&d[4], ymm + in->dst * 16, 16);
+		memcpy(&a[4], ymm + in->src1 * 16, 16);
+		if (in->src2 >= 0)
+			memcpy(&c[4], ymm + in->src2 * 16, 16);
+	}
+	gb_vnni_lanes(in->op, d, a, c, ndw);
+
+	memcpy(&xmm[in->dst * 4], &d[0], 16);
+	if (ymm) {				/* bit set: the real upper half (L=1) or zero (VEX.128) */
+		if (in->l)
+			memcpy(ymm + in->dst * 16, &d[4], 16);
+		else
+			memset(ymm + in->dst * 16, 0, 16);
+	}					/* bit clear: every upper half is 0 and so is the result's */
+	if (zhi) {				/* VEX zeroes bits MAXVL-1:256 (dst <= 15) */
+		memset(zhi + in->dst * 32, 0, 32);
+		fl |= GB_VNNI_F_ZMMHI;
+	}
+	return fl;
+}
+
+#endif /* _GB_VNNI_CORE_H */
diff --git a/arch/x86/kernel/traps.c b/arch/x86/kernel/traps.c
index 6b22611e69cc..33c35c443723 100644
--- a/arch/x86/kernel/traps.c
+++ b/arch/x86/kernel/traps.c
@@ -295,12 +295,263 @@ DEFINE_IDTENTRY(exc_overflow)
 	do_error_trap(regs, 0, "overflow", X86_TRAP_OF, SIGSEGV, 0, NULL);
 }
 
+
+/*
+ * GB_VNNI_EMULATION v4 (kernel build #15): emulate VEX-encoded AVX-VNNI (VEX.128/256, register and memory
+ * source) for 64-bit user mode; Ice Lake has only the EVEX (AVX512_VNNI) forms. Decode, lanes and the xstate
+ * merge are in gb_vnni_core.h. Generated by kernel/scripts/apply_vnni4.py.
+ * Invariant: the user copies (instruction, memory operand) run with IRQs on and before kernel_fpu_begin();
+ * nothing between kernel_fpu_begin() and kernel_fpu_end() may fault, sleep or take gb_vnni_lock.
+ * Counter: /sys/kernel/gb_vnni/summary (0400) and reset (0200).
+ * Known gaps: legacy prefixes before VEX are not emulated (SIGILL); a faulting memory operand gives SIGILL, not
+ * SIGSEGV (counted as efault); under single-step (TF) the emulated instruction does not raise the debug trap.
+ * IRQ/ymm/xstate review from github.com/linuxkid473/gbos-x86 @f8a5c1a HANDOFF.md:59-62; code is ours.
+ */
+#include <asm/fpu/types.h>
+#include <linux/kobject.h>
+#include <linux/sysfs.h>
+#include "gb_vnni_core.h"
+
+#define GB_VNNI_NLRU	16
+
+struct gb_vnni_bucket {
+	char comm[TASK_COMM_LEN];
+	unsigned long rip;
+	u64 count;
+	u64 used;			/* clock at the last hit; 0 = empty */
+};
+
+static struct {
+	u64 emulated, vex128, vex256, word, byte, irqon, efault, sse_init, ymm_init, zmmhi;
+	u64 clock;
+	struct gb_vnni_bucket lru[GB_VNNI_NLRU];
+} gb_vnni_stats;
+static DEFINE_SPINLOCK(gb_vnni_lock);
+
+static u64 gb_gpr(struct pt_regs *regs, int n)
+{
+	switch (n) {
+	case 0: return regs->ax;  case 1: return regs->cx;  case 2: return regs->dx;  case 3: return regs->bx;
+	case 4: return regs->sp;  case 5: return regs->bp;  case 6: return regs->si;  case 7: return regs->di;
+	case 8: return regs->r8;  case 9: return regs->r9;  case 10: return regs->r10; case 11: return regs->r11;
+	case 12: return regs->r12; case 13: return regs->r13; case 14: return regs->r14; case 15: return regs->r15;
+	}
+	return 0;
+}
+
+static void gb_vnni_efault(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&gb_vnni_lock, flags);
+	gb_vnni_stats.efault++;
+	spin_unlock_irqrestore(&gb_vnni_lock, flags);
+}
+
+static void gb_vnni_account(const struct gb_vnni_insn *in, unsigned int fl, bool irqon, unsigned long rip)
+{
+	struct gb_vnni_bucket *b = NULL, *victim;
+	char comm[TASK_COMM_LEN];
+	unsigned long flags;
+	bool fresh = false;
+	int i;
+
+	get_task_comm(comm, current);
+	spin_lock_irqsave(&gb_vnni_lock, flags);
+	gb_vnni_stats.emulated++;
+	if (in->l)
+		gb_vnni_stats.vex256++;
+	else
+		gb_vnni_stats.vex128++;
+	if (in->op >= 0x52)
+		gb_vnni_stats.word++;
+	else
+		gb_vnni_stats.byte++;
+	if (irqon)
+		gb_vnni_stats.irqon++;
+	if (fl & GB_VNNI_F_SSE_INIT)
+		gb_vnni_stats.sse_init++;
+	if (fl & GB_VNNI_F_YMM_INIT)
+		gb_vnni_stats.ymm_init++;
+	if (fl & GB_VNNI_F_ZMMHI)
+		gb_vnni_stats.zmmhi++;
+	victim = &gb_vnni_stats.lru[0];
+	for (i = 0; i < GB_VNNI_NLRU; i++) {
+		struct gb_vnni_bucket *e = &gb_vnni_stats.lru[i];
+
+		if (e->used && e->rip == rip && !strncmp(e->comm, comm, TASK_COMM_LEN)) {
+			b = e;
+			break;
+		}
+		if (e->used < victim->used)
+			victim = e;
+	}
+	if (!b) {				/* a new (comm, rip): replace the least recently used bucket */
+		b = victim;
+		memcpy(b->comm, comm, TASK_COMM_LEN);
+		b->rip = rip;
+		b->count = 0;
+		fresh = true;
+	}
+	b->count++;
+	b->used = ++gb_vnni_stats.clock;
+	spin_unlock_irqrestore(&gb_vnni_lock, flags);
+	if (fresh)
+		printk_ratelimited(KERN_INFO "gb_vnni: emulating VEX AVX-VNNI for comm=%s\n", comm);
+}
+
+static noinline bool gb_emulate_vnni(struct pt_regs *regs)
+{
+	u8 ib[MAX_INSN_SIZE];
+	struct gb_vnni_insn in;
+	struct xregs_state *xs;
+	unsigned long rip = regs->ip;
+	unsigned int fl;
+	u32 mem[8];
+	u8 *ymm, *zhi;
+	bool irqon;
+	u64 xf;
+	int n;
+
+	if (!user_mode(regs) || !user_64bit_mode(regs))
+		return false;
+	if (!cpu_feature_enabled(X86_FEATURE_AVX))	/* no AVX in XCR0: a VEX instruction must #UD */
+		return false;
+	if (uprobe_get_trap_addr(regs) != rip)		/* uprobe XOL slot: ip + len is not the next instruction */
+		return false;
+
+	irqon = !irqs_disabled();
+	n = insn_fetch_from_user(regs, ib);		/* sleepable; a short read at a page end is fine */
+	switch (gb_vnni_decode(ib, n, &in)) {
+	case GB_VNNI_OK:
+		break;
+	case GB_VNNI_SHORT:
+		gb_vnni_efault();
+		return false;
+	default:
+		return false;
+	}
+	memset(mem, 0, sizeof(mem));
+	if (in.src2 < 0) {
+		u64 ea = gb_vnni_ea(&in, in.base >= 0 ? gb_gpr(regs, in.base) : 0,
+				    in.index >= 0 ? gb_gpr(regs, in.index) : 0, rip + in.len);
+
+		if (copy_from_user(mem, (const void __user *)(unsigned long)ea, in.l ? 32 : 16)) {
+			gb_vnni_efault();
+			return false;
+		}
+	}
+
+	/* no user access, no sleeping and no gb_vnni_lock from here to kernel_fpu_end() */
+	kernel_fpu_begin();
+	xs = &x86_task_fpu(current)->fpstate->regs.xsave;
+	xf = xs->header.xfeatures;
+	/* header bit first: get_xsave_addr() WARNs for a feature that is not enabled */
+	ymm = (xf & XFEATURE_MASK_YMM) ? get_xsave_addr(xs, XFEATURE_YMM) : NULL;
+	zhi = (xf & XFEATURE_MASK_ZMM_Hi256) ? get_xsave_addr(xs, XFEATURE_ZMM_Hi256) : NULL;
+	fl = gb_vnni_merge(&in, mem, xs->i387.xmm_space, &xs->header.xfeatures, ymm, zhi);
+	kernel_fpu_end();
+
+	regs->ip = rip + in.len;
+	gb_vnni_account(&in, fl, irqon, rip);
+	return true;
+}
+
+static ssize_t gb_vnni_summary_show(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+	const struct gb_vnni_bucket *e;
+	bool done[GB_VNNI_NLRU] = { };
+	unsigned long flags;
+	int len, i, k, best;
+
+	spin_lock_irqsave(&gb_vnni_lock, flags);
+	len = sysfs_emit(buf, "emulated %llu vex128 %llu vex256 %llu word %llu byte %llu irqon %llu efault %llu "
+			 "sse_init %llu ymm_init %llu zmmhi %llu\n",
+			 gb_vnni_stats.emulated, gb_vnni_stats.vex128, gb_vnni_stats.vex256, gb_vnni_stats.word,
+			 gb_vnni_stats.byte, gb_vnni_stats.irqon, gb_vnni_stats.efault, gb_vnni_stats.sse_init,
+			 gb_vnni_stats.ymm_init, gb_vnni_stats.zmmhi);
+	for (k = 0; k < GB_VNNI_NLRU; k++) {	/* most recently used first */
+		best = -1;
+		for (i = 0; i < GB_VNNI_NLRU; i++)
+			if (!done[i] && gb_vnni_stats.lru[i].used &&
+			    (best < 0 || gb_vnni_stats.lru[i].used > gb_vnni_stats.lru[best].used))
+				best = i;
+		if (best < 0)
+			break;
+		done[best] = true;
+		e = &gb_vnni_stats.lru[best];
+		len += sysfs_emit_at(buf, len, "comm=%s rip=%lx count=%llu\n", e->comm, e->rip, e->count);
+	}
+	spin_unlock_irqrestore(&gb_vnni_lock, flags);
+	return len;
+}
+
+static ssize_t gb_vnni_reset_store(struct kobject *kobj, struct kobj_attribute *attr, const char *buf,
+				   size_t count)
+{
+	unsigned long flags;
+
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	spin_lock_irqsave(&gb_vnni_lock, flags);
+	memset(&gb_vnni_stats, 0, sizeof(gb_vnni_stats));
+	spin_unlock_irqrestore(&gb_vnni_lock, flags);
+	return count;
+}
+
+static struct kobj_attribute gb_vnni_summary_attr = __ATTR(summary, 0400, gb_vnni_summary_show, NULL);
+static struct kobj_attribute gb_vnni_reset_attr = __ATTR(reset, 0200, NULL, gb_vnni_reset_store);
+static struct attribute *gb_vnni_attrs[] = {
+	&gb_vnni_summary_attr.attr,
+	&gb_vnni_reset_attr.attr,
+	NULL,
+};
+static const struct attribute_group gb_vnni_group = {
+	.attrs = gb_vnni_attrs,
+};
+
+static int __init gb_vnni_sysfs_init(void)
+{
+	struct kobject *kobj;
+	int rc;
+
+	BUILD_BUG_ON(GB_VNNI_XF_SSE != XFEATURE_MASK_SSE);
+	BUILD_BUG_ON(GB_VNNI_XF_YMM != XFEATURE_MASK_YMM);
+	BUILD_BUG_ON(GB_VNNI_XF_ZMM_HI256 != XFEATURE_MASK_ZMM_Hi256);
+	BUILD_BUG_ON(sizeof(((struct fxregs_state *)0)->xmm_space) != 16 * 16);
+
+	/* failure only logs: the emulator works without the node */
+	kobj = kobject_create_and_add("gb_vnni", kernel_kobj);
+	if (!kobj) {
+		pr_warn("gb_vnni: cannot create /sys/kernel/gb_vnni\n");
+		return 0;
+	}
+	rc = sysfs_create_group(kobj, &gb_vnni_group);
+	if (rc) {
+		pr_warn("gb_vnni: cannot create the counter files (%d)\n", rc);
+		kobject_put(kobj);
+	}
+	return 0;
+}
+late_initcall(gb_vnni_sysfs_init);
+
 #ifdef CONFIG_X86_F00F_BUG
 void handle_invalid_op(struct pt_regs *regs)
 #else
 static inline void handle_invalid_op(struct pt_regs *regs)
 #endif
 {
+	if (user_mode(regs)) {
+		bool done;
+
+		/* GB_VNNI_EMULATION: user copies with IRQs on, as do_error_trap() does */
+		cond_local_irq_enable(regs);
+		done = gb_emulate_vnni(regs);
+		cond_local_irq_disable(regs);
+		if (done)
+			return;
+	}
+
 	do_error_trap(regs, 0, "invalid opcode", X86_TRAP_UD, SIGILL,
 		      ILL_ILLOPN, error_get_trap_addr(regs));
 }
