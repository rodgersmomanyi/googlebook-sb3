From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GB-build k16 <k16@builder.invalid>
Date: Mon, 26 Oct 2026 20:00:00 +0000
Subject: [PATCH 112/112] x86/traps: gb_vnni: escape the task name in the
 summary and kmsg

LOW-3 of the wave-3 review: /sys/kernel/gb_vnni/summary printed the comm
of each comm/RIP bucket with a plain %s, and so did the one rate-limited
"gb_vnni: emulating VEX AVX-VNNI for comm=" kmsg line. Every task sets
its own comm (prctl(PR_SET_NAME), /proc/<pid>/comm) to any 15 bytes,
newlines and other control characters included, so one emulating
process could append whole fake lines (for example "x\nVNNI total 0")
to the summary, push real buckets out of the 17 lines that gb_bootlog's
"== summary" block shows, hide its own bucket from the KAT's parser and
forge section headers ("\n== uptime") for the gblog tools.

The comm is now printed through string_escape_mem() with
ESCAPE_HEX | ESCAPE_NAP | ESCAPE_APPEND and the extra set "\\=":
printable ASCII and the blank pass unchanged ("Profile Saver" stays
as it is), while '\', '=' and every other byte (control characters,
DEL, bytes >= 0x80) become \xHH. Each bucket therefore stays exactly
one line, the first line and the field order "comm=<comm> rip=<hex>
count=<N>" are unchanged, '\' keeps the encoding reversible and '='
keeps the key=value fields unambiguous. A name without such bytes
(every comm recorded in the k15 VM measurements) prints byte for byte
as on k15, so the existing parsers keep working. The buckets still
match on the raw comm.

The worst-case summary grows from about 1.4 KiB to about 2.1 KiB
(16 buckets of 15 escaped bytes, 60 characters each), well inside the
sysfs page. string_escape_mem() is built in (lib/string_helpers.o is
obj-y): no new export, no config change, vmlinux.symvers unchanged.

Fixes LOW-3 (deferred from k15 to the next kernel build, kbuild16).
---
 arch/x86/kernel/traps.c | 31 +++++++++++++++++++++++++++----
 1 file changed, 27 insertions(+), 4 deletions(-)

diff --git a/arch/x86/kernel/traps.c b/arch/x86/kernel/traps.c
index 33c35c443723..0ac530ff214d 100644
--- a/arch/x86/kernel/traps.c
+++ b/arch/x86/kernel/traps.c
@@ -302,13 +302,15 @@ DEFINE_IDTENTRY(exc_overflow)
  * merge are in gb_vnni_core.h. Generated by kernel/scripts/apply_vnni4.py.
  * Invariant: the user copies (instruction, memory operand) run with IRQs on and before kernel_fpu_begin();
  * nothing between kernel_fpu_begin() and kernel_fpu_end() may fault, sleep or take gb_vnni_lock.
- * Counter: /sys/kernel/gb_vnni/summary (0400) and reset (0200).
+ * Counter: /sys/kernel/gb_vnni/summary (0400) and reset (0200). The task name is printed escaped (summary and
+ * kmsg, gb_vnni_comm_esc(); kernel build #16, LOW-3).
  * Known gaps: legacy prefixes before VEX are not emulated (SIGILL); a faulting memory operand gives SIGILL, not
  * SIGSEGV (counted as efault); under single-step (TF) the emulated instruction does not raise the debug trap.
  * IRQ/ymm/xstate review from github.com/linuxkid473/gbos-x86 @f8a5c1a HANDOFF.md:59-62; code is ours.
  */
 #include <asm/fpu/types.h>
 #include <linux/kobject.h>
+#include <linux/string_helpers.h>
 #include <linux/sysfs.h>
 #include "gb_vnni_core.h"
 
@@ -348,10 +350,28 @@ static void gb_vnni_efault(void)
 	spin_unlock_irqrestore(&gb_vnni_lock, flags);
 }
 
+/*
+ * LOW-3: every task sets its own comm (prctl(PR_SET_NAME), /proc/<pid>/comm), so the summary and the kmsg line
+ * print it escaped, as one token that cannot end the line: printable ASCII passes unchanged, blanks included
+ * ("Profile Saver"), except '\' and '='; those and every other byte (control characters such as '\n', DEL, bytes
+ * >= 0x80) become \xHH. '\' keeps the encoding reversible and '=' keeps "comm=<comm> rip=<hex> count=<N>"
+ * unambiguous. A name without such bytes prints exactly as before.
+ */
+#define GB_VNNI_COMM_ESC	(4 * TASK_COMM_LEN + 1)	/* every byte as \xHH, plus the NUL */
+
+static const char *gb_vnni_comm_esc(char *out, const char *comm)
+{
+	int n = string_escape_mem(comm, strnlen(comm, TASK_COMM_LEN), out, GB_VNNI_COMM_ESC - 1,
+				  ESCAPE_HEX | ESCAPE_NAP | ESCAPE_APPEND, "\\=");
+
+	out[min_t(int, n, GB_VNNI_COMM_ESC - 1)] = '\0';	/* n <= 4 * TASK_COMM_LEN: never truncated */
+	return out;
+}
+
 static void gb_vnni_account(const struct gb_vnni_insn *in, unsigned int fl, bool irqon, unsigned long rip)
 {
 	struct gb_vnni_bucket *b = NULL, *victim;
-	char comm[TASK_COMM_LEN];
+	char comm[TASK_COMM_LEN], esc[GB_VNNI_COMM_ESC];
 	unsigned long flags;
 	bool fresh = false;
 	int i;
@@ -397,7 +417,8 @@ static void gb_vnni_account(const struct gb_vnni_insn *in, unsigned int fl, bool
 	b->used = ++gb_vnni_stats.clock;
 	spin_unlock_irqrestore(&gb_vnni_lock, flags);
 	if (fresh)
-		printk_ratelimited(KERN_INFO "gb_vnni: emulating VEX AVX-VNNI for comm=%s\n", comm);
+		printk_ratelimited(KERN_INFO "gb_vnni: emulating VEX AVX-VNNI for comm=%s\n",
+				   gb_vnni_comm_esc(esc, comm));
 }
 
 static noinline bool gb_emulate_vnni(struct pt_regs *regs)
@@ -461,6 +482,7 @@ static ssize_t gb_vnni_summary_show(struct kobject *kobj, struct kobj_attribute
 {
 	const struct gb_vnni_bucket *e;
 	bool done[GB_VNNI_NLRU] = { };
+	char esc[GB_VNNI_COMM_ESC];
 	unsigned long flags;
 	int len, i, k, best;
 
@@ -480,7 +502,8 @@ static ssize_t gb_vnni_summary_show(struct kobject *kobj, struct kobj_attribute
 			break;
 		done[best] = true;
 		e = &gb_vnni_stats.lru[best];
-		len += sysfs_emit_at(buf, len, "comm=%s rip=%lx count=%llu\n", e->comm, e->rip, e->count);
+		len += sysfs_emit_at(buf, len, "comm=%s rip=%lx count=%llu\n", gb_vnni_comm_esc(esc, e->comm),
+				     e->rip, e->count);
 	}
 	spin_unlock_irqrestore(&gb_vnni_lock, flags);
 	return len;
