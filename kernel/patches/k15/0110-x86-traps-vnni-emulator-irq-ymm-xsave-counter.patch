+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * GB_VNNI_EMULATION core (Googlebook SB3, kernel build #15): decode, dot-product lanes and xstate merge of the
+ * VEX-encoded AVX-VNNI instructions VPDPBUSD, VPDPBUSDS, VPDPWSSD and VPDPWSSDS (VEX.66.0F38.W0 50-53, VEX.128
+ * and VEX.256, register or memory source).
+ *
+ * No kernel-only calls: included by arch/x86/kernel/traps.c and by the host unit test
+ * kernel/tools/test_gb_vnni_core.c (KAT-0). The includer provides u8..u64, s8..s64, bool, NULL, S32_MIN,
+ * S32_MAX, memcpy() and memset(). Generated by kernel/scripts/apply_vnni4.py.
+ *
+ * xstate rules: a component is read or written only when its XSTATE_BV header bit is set. The YMM and ZMM_Hi256
+ * bits are never set here: when a bit is clear the buffer bytes are stale and the registers are architecturally
+ * zero. SSE in its init state is materialised as 16 zero registers before its bit is set. A VEX.128/VEX.256
+ * destination is zeroed above bit 127/255 up to MAXVL (bits 511:256 live in ZMM_Hi256).
+ *
+ * IRQ/ymm/xstate review from github.com/linuxkid473/gbos-x86 @f8a5c1a HANDOFF.md:59-62; code is ours.
+ */
+#ifndef _GB_VNNI_CORE_H
+#define _GB_VNNI_CORE_H
+
+#define GB_VNNI_XF_SSE		(1ULL << 1)	/* XFEATURE_SSE */
+#define GB_VNNI_XF_YMM		(1ULL << 2)	/* XFEATURE_YMM */
+#define GB_VNNI_XF_ZMM_HI256	(1ULL << 6)	/* XFEATURE_ZMM_Hi256 */
+
+/* gb_vnni_decode() results */
+#define GB_VNNI_OK		0
+#define GB_VNNI_NOT		1	/* not an encoding we emulate: SIGILL as before */
+#define GB_VNNI_SHORT		2	/* every fetched byte matches, but fewer than the length were fetched */
+
+/* gb_vnni_merge() result flags (counters) */
+#define GB_VNNI_F_SSE_INIT	1	/* SSE was in its init state */
+#define GB_VNNI_F_YMM_INIT	2	/* YMM was in its init state */
+#define GB_VNNI_F_ZMMHI		4	/* a ZMM_Hi256 slot was zeroed */
+
+struct gb_vnni_insn {
+	u8 op;		/* 0x50 vpdpbusd, 0x51 vpdpbusds, 0x52 vpdpwssd, 0x53 vpdpwssds */
+	u8 l;		/* VEX.L: 0 = 128-bit, 1 = 256-bit */
+	u8 dst;		/* ModRM.reg + VEX.R: accumulator and destination */
+	u8 src1;	/* VEX.vvvv: unsigned bytes (50/51) or signed words (52/53) */
+	s8 src2;	/* ModRM.rm + VEX.B: signed bytes or words; -1 = memory operand */
+	u8 len;		/* instruction length */
+	s8 base;	/* memory operand: base GPR 0-15, or -1 */
+	s8 index;	/* memory operand: index GPR 0-15, or -1 */
+	u8 scale;	/* memory operand: index shift 0-3 */
+	u8 rip;		/* memory operand: RIP-relative */
+	s32 disp;	/* memory operand: displacement */
+};
+
+/*
+ * Decode the n fetched bytes at the faulting ip. Only the 3-byte VEX prefix can encode map 0F38; legacy prefixes
+ * before it are not emulated. VEX.W1 is not AVX-VNNI and pp != 66 selects other instructions (AVX-VNNI-INT8).
+ */
+static inline int gb_vnni_decode(const u8 *ib, int n, struct gb_vnni_insn *in)
+{
+	u8 p0, p1, modrm, mod, rm, sib;
+	int r, x, b, len, i;
+
+	if (n < 1)
+		return GB_VNNI_SHORT;
+	if (ib[0] != 0xc4)
+		return GB_VNNI_NOT;
+	if (n < 2)
+		return GB_VNNI_SHORT;
+	if ((ib[1] & 0x1f) != 0x02)		/* m-mmmm: 0F38 */
+		return GB_VNNI_NOT;
+	if (n < 3)
+		return GB_VNNI_SHORT;
+	if ((ib[2] & 0x83) != 0x01)		/* W0, pp = 66 */
+		return GB_VNNI_NOT;
+	if (n < 4)
+		return GB_VNNI_SHORT;
+	if (ib[3] < 0x50 || ib[3] > 0x53)
+		return GB_VNNI_NOT;
+	if (n < 5)
+		return GB_VNNI_SHORT;
+
+	p0 = ib[1];
+	p1 = ib[2];
+	modrm = ib[4];
+	r = ((p0 >> 7) & 1) ^ 1;
+	x = ((p0 >> 6) & 1) ^ 1;
+	b = ((p0 >> 5) & 1) ^ 1;
+	mod = (modrm >> 6) & 3;
+	rm = modrm & 7;
+
+	in->op = ib[3];
+	in->l = (p1 >> 2) & 1;
+	in->src1 = (~(p1 >> 3)) & 0x0f;
+	in->dst = ((modrm >> 3) & 7) | (r << 3);
+	in->src2 = -1;
+	in->base = -1;
+	in->index = -1;
+	in->scale = 0;
+	in->rip = 0;
+	in->disp = 0;
+
+	if (mod == 3) {
+		in->src2 = rm | (b << 3);
+		in->len = 5;
+		return GB_VNNI_OK;
+	}
+
+	/* the length first, so that a short fetch is recognised before any byte past it is read */
+	len = 5;
+	if (rm == 4) {
+		if (n < 6)
+			return GB_VNNI_SHORT;
+		len = 6;
+		if ((ib[5] & 7) == 5 && mod == 0)
+			len += 4;		/* SIB base 101, mod 00: disp32, no base */
+	} else if (rm == 5 && mod == 0) {
+		len += 4;			/* RIP + disp32 */
+	}
+	if (mod == 1)
+		len += 1;
+	else if (mod == 2)
+		len += 4;
+	if (len > n)
+		return GB_VNNI_SHORT;
+	in->len = len;
+
+	i = 5;
+	if (rm == 4) {
+		sib = ib[5];
+		i = 6;
+		in->scale = (sib >> 6) & 3;
+		if (((sib >> 3) & 7) != 4 || x)	/* index 100 without VEX.X: none (r12 is valid) */
+			in->index = ((sib >> 3) & 7) | (x << 3);
+		if ((sib & 7) == 5 && mod == 0) {
+			in->disp = (s32)((u32)ib[6] | ((u32)ib[7] << 8) | ((u32)ib[8] << 16) | ((u32)ib[9] << 24));
+			i = 10;
+		} else {
+			in->base = (sib & 7) | (b << 3);
+		}
+	} else if (rm == 5 && mod == 0) {
+		in->rip = 1;
+		in->disp = (s32)((u32)ib[5] | ((u32)ib[6] << 8) | ((u32)ib[7] << 16) | ((u32)ib[8] << 24));
+		i = 9;
+	} else {
+		in->base = rm | (b << 3);
+	}
+	if (mod == 1)
+		in->disp = (s8)ib[i];
+	else if (mod == 2)
+		in->disp = (s32)((u32)ib[i] | ((u32)ib[i + 1] << 8) | ((u32)ib[i + 2] << 16) | ((u32)ib[i + 3] << 24));
+	return GB_VNNI_OK;
+}
+
+/* effective address (64-bit addressing); the caller passes the GPR values (0 when absent) and ip + len */
+static inline u64 gb_vnni_ea(const struct gb_vnni_insn *in, u64 base, u64 index, u64 next_ip)
+{
+	u64 ea = (u64)(s64)in->disp;
+
+	if (in->rip)
+		ea += next_ip;
+	if (in->base >= 0)
+		ea += base;
+	if (in->index >= 0)
+		ea += index << in->scale;
+	return ea;
+}
+
+static inline s32 gb_vnni_sat_s32(s64 v)
+{
+	if (v > (s64)S32_MAX)
+		return S32_MAX;
+	if (v < (s64)S32_MIN)
+		return S32_MIN;
+	return (s32)v;
+}
+
+/* d[i] += dot(a[i], c[i]) per dword; a = src1 (u8 or s16), c = src2 (s8 or s16); 51/53 saturate */
+static inline void gb_vnni_lanes(u8 op, u32 *d, const u32 *a, const u32 *c, int ndw)
+{
+	int i, k;
+
+	for (i = 0; i < ndw; i++) {
+		s64 acc = (s32)d[i];
+
+		if (op >= 0x52) {
+			for (k = 0; k < 2; k++)
+				acc += (s64)(s16)(a[i] >> (16 * k)) * (s16)(c[i] >> (16 * k));
+		} else {
+			for (k = 0; k < 4; k++)
+				acc += (s64)(u8)(a[i] >> (8 * k)) * (s8)(c[i] >> (8 * k));
+		}
+		if (op == 0x51 || op == 0x53)
+			d[i] = (u32)gb_vnni_sat_s32(acc);
+		else
+			d[i] = (u32)acc;
+	}
+}
+
+/*
+ * Execute the decoded instruction on a task's saved register image.
+ *   mem:       the memory source (16 or 32 bytes) when in->src2 < 0, else unused
+ *   xmm:       the legacy XMM0-15 area (i387.xmm_space, 64 dwords; fixed offset in every XSAVE format)
+ *   xfeatures: the XSAVE header XSTATE_BV
+ *   ymm, zhi:  the YMM (16 x 16 B) and ZMM_Hi256 (16 x 32 B) components, or NULL; ignored when their header bit
+ *              is clear
+ * Returns GB_VNNI_F_* flags.
+ */
+static inline unsigned int gb_vnni_merge(const struct gb_vnni_insn *in, const u32 *mem, u32 *xmm, u64 *xfeatures,
+					 u8 *ymm, u8 *zhi)
+{
+	u32 d[8], a[8], c[8];
+	u64 xf = *xfeatures;
+	unsigned int fl = 0;
+	int ndw = in->l ? 8 : 4;
+
+	if (!(xf & GB_VNNI_XF_YMM))
+		ymm = NULL;
+	if (!(xf & GB_VNNI_XF_ZMM_HI256))
+		zhi = NULL;
+	if (!(xf & GB_VNNI_XF_SSE)) {		/* init state: XMM0-15 are 0, the buffer bytes are stale */
+		memset(xmm, 0, 16 * 16);
+		*xfeatures = xf | GB_VNNI_XF_SSE;	/* safe: the whole XMM area is now valid */
+		fl |= GB_VNNI_F_SSE_INIT;
+	}
+	if (!ymm)
+		fl |= GB_VNNI_F_YMM_INIT;
+
+	memset(d, 0, sizeof(d));
+	memset(a, 0, sizeof(a));
+	memset(c, 0, sizeof(c));
+	memcpy(&d[0], &xmm[in->dst * 4], 16);
+	memcpy(&a[0], &xmm[in->src1 * 4], 16);
+	if (in->src2 >= 0)
+		memcpy(&c[0], &xmm[in->src2 * 4], 16);
+	else
+		memcpy(c, mem, ndw * 4);
+	if (in->l && ymm) {			/* without ymm the upper halves of d, a (and a register c) are 0 */
+		memcpy(&d[4], ymm + in->dst * 16, 16);
+		memcpy(&a[4], ymm + in->src1 * 16, 16);
+		if (in->src2 >= 0)
+			memcpy(&c[4], ymm + in->src2 * 16, 16);
+	}
+	gb_vnni_lanes(in->op, d, a, c, ndw);
+
+	memcpy(&xmm[in->dst * 4], &d[0], 16);
+	if (ymm) {				/* bit set: the real upper half (L=1) or zero (VEX.128) */
+		if (in->l)
+			memcpy(ymm + in->dst * 16, &d[4], 16);
+		else
+			memset(ymm + in->dst * 16, 0, 16);
+	}					/* bit clear: every upper half is 0 and so is the result's */
+	if (zhi) {				/* VEX zeroes bits MAXVL-1:256 (dst <= 15) */
+		memset(zhi + in->dst * 32, 0, 32);
+		fl |= GB_VNNI_F_ZMMHI;
+	}
+	return fl;
+}
+
+#endif /* _GB_VNNI_CORE_H */
