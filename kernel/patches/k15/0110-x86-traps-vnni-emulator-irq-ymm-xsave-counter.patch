+static ssize_t gb_vnni_summary_show(struct kobject *kobj, struct kobj_attribute *attr, char *buf)
+{
+	const struct gb_vnni_bucket *e;
+	bool done[GB_VNNI_NLRU] = { };
+	unsigned long flags;
+	int len, i, k, best;
+
+	spin_lock_irqsave(&gb_vnni_lock, flags);
+	len = sysfs_emit(buf, "emulated %llu vex128 %llu vex256 %llu word %llu byte %llu irqon %llu efault %llu "
+			 "sse_init %llu ymm_init %llu zmmhi %llu\n",
+			 gb_vnni_stats.emulated, gb_vnni_stats.vex128, gb_vnni_stats.vex256, gb_vnni_stats.word,
+			 gb_vnni_stats.byte, gb_vnni_stats.irqon, gb_vnni_stats.efault, gb_vnni_stats.sse_init,
+			 gb_vnni_stats.ymm_init, gb_vnni_stats.zmmhi);
+	for (k = 0; k < GB_VNNI_NLRU; k++) {	/* most recently used first */
+		best = -1;
+		for (i = 0; i < GB_VNNI_NLRU; i++)
+			if (!done[i] && gb_vnni_stats.lru[i].used &&
+			    (best < 0 || gb_vnni_stats.lru[i].used > gb_vnni_stats.lru[best].used))
+				best = i;
+		if (best < 0)
+			break;
+		done[best] = true;
+		e = &gb_vnni_stats.lru[best];
+		len += sysfs_emit_at(buf, len, "comm=%s rip=%lx count=%llu\n", e->comm, e->rip, e->count);
+	}
+	spin_unlock_irqrestore(&gb_vnni_lock, flags);
+	return len;
+}
+
+static ssize_t gb_vnni_reset_store(struct kobject *kobj, struct kobj_attribute *attr, const char *buf,
+				   size_t count)
+{
+	unsigned long flags;
+
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	spin_lock_irqsave(&gb_vnni_lock, flags);
+	memset(&gb_vnni_stats, 0, sizeof(gb_vnni_stats));
+	spin_unlock_irqrestore(&gb_vnni_lock, flags);
+	return count;
+}
+
+static struct kobj_attribute gb_vnni_summary_attr = __ATTR(summary, 0400, gb_vnni_summary_show, NULL);
+static struct kobj_attribute gb_vnni_reset_attr = __ATTR(reset, 0200, NULL, gb_vnni_reset_store);
+static struct attribute *gb_vnni_attrs[] = {
+	&gb_vnni_summary_attr.attr,
+	&gb_vnni_reset_attr.attr,
+	NULL,
+};
+static const struct attribute_group gb_vnni_group = {
+	.attrs = gb_vnni_attrs,
+};
+
+static int __init gb_vnni_sysfs_init(void)
+{
+	struct kobject *kobj;
+	int rc;
+
+	BUILD_BUG_ON(GB_VNNI_XF_SSE != XFEATURE_MASK_SSE);
+	BUILD_BUG_ON(GB_VNNI_XF_YMM != XFEATURE_MASK_YMM);
+	BUILD_BUG_ON(GB_VNNI_XF_ZMM_HI256 != XFEATURE_MASK_ZMM_Hi256);
+	BUILD_BUG_ON(sizeof(((struct fxregs_state *)0)->xmm_space) != 16 * 16);
+
+	/* failure only logs: the emulator works without the node */
+	kobj = kobject_create_and_add("gb_vnni", kernel_kobj);
+	if (!kobj) {
+		pr_warn("gb_vnni: cannot create /sys/kernel/gb_vnni\n");
+		return 0;
+	}
+	rc = sysfs_create_group(kobj, &gb_vnni_group);
+	if (rc) {
+		pr_warn("gb_vnni: cannot create the counter files (%d)\n", rc);
+		kobject_put(kobj);
+	}
+	return 0;
+}
+late_initcall(gb_vnni_sysfs_init);
