@@ -143,6 +143,12 @@ static unsigned int cache_time = 1000;
 module_param(cache_time, uint, 0644);
 MODULE_PARM_DESC(cache_time, "battery state caching time in milliseconds [default: 1000]");
 
+static bool scope_device;
+module_param(scope_device, bool, 0644);
+MODULE_PARM_DESC(scope_device, "report the batteries with scope \"Device\" instead of \"System\", so that user space "
+		 "picking the system battery (e.g. the Android health HAL) skips them, for use when a combined battery is "
+		 "provided elsewhere [default: false]");
+
 
 /* -- State management. ----------------------------------------------------- */
 
@@ -428,6 +434,7 @@ static void spwr_external_power_changed(struct power_supply *psy)
 static const enum power_supply_property spwr_battery_props_chg[] = {
 	POWER_SUPPLY_PROP_STATUS,
 	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_SCOPE,
 	POWER_SUPPLY_PROP_TECHNOLOGY,
 	POWER_SUPPLY_PROP_CYCLE_COUNT,
 	POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
@@ -446,6 +453,7 @@ static const enum power_supply_property spwr_battery_props_chg[] = {
 static const enum power_supply_property spwr_battery_props_eng[] = {
 	POWER_SUPPLY_PROP_STATUS,
 	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_SCOPE,
 	POWER_SUPPLY_PROP_TECHNOLOGY,
 	POWER_SUPPLY_PROP_CYCLE_COUNT,
 	POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
@@ -547,6 +555,16 @@ static int spwr_battery_get_property(struct power_supply *psy, enum power_supply
 	u32 value;
 	int status;
 
+	/*
+	 * Answer the scope without talking to the EC: it must not fail, user
+	 * space treats an unreadable scope as "System".
+	 */
+	if (psp == POWER_SUPPLY_PROP_SCOPE) {
+		val->intval = READ_ONCE(scope_device) ? POWER_SUPPLY_SCOPE_DEVICE
+						      : POWER_SUPPLY_SCOPE_SYSTEM;
+		return 0;
+	}
+
 	mutex_lock(&bat->lock);
 
 	status = spwr_battery_update_bst_unlocked(bat, true);
